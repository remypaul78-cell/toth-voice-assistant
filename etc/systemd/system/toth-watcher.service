[Unit]
Description=Toth Announce Watcher v2 — vocal flag
After=network.target sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/toth
ExecStart=/usr/bin/python3 -u /home/pi/toth/watcher_v2.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
