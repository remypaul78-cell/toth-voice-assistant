[Unit]
Description=Toth Auto-Heal Watchdog
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/toth
ExecStart=/usr/bin/python3 /home/pi/toth/toth_autoheal.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
