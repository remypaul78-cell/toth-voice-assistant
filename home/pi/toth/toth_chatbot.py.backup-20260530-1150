# Battery overlay
import smbus2
PI_SUGAR_ADDR = 0x57

def read_battery():
    """Return battery percentage from PiSugar I2C (register 0x2A), or -1."""
    try:
        bus = smbus2.SMBus(1)
        pct = bus.read_byte_data(PI_SUGAR_ADDR, 0x2A)
        bus.close()
        return max(0, min(100, pct))
    except Exception:
        return -1

def overlay_battery_on_raw(raw_bytes, width=240, height=280):
    """Overlay battery icon directly in RGB565 — NO PIL conversion, fast on Pi Zero."""
    buf = bytearray(raw_bytes)  # mutable copy
    
    pct = read_battery()
    if pct < 0:
        pct = 0
    
    # Icon position (top-right)
    icon_w, icon_h = 56, 24
    margin_right, margin_top = 8, 4
    bx = width - margin_right - icon_w
    by = margin_top
    body_w = icon_w - 6
    
    # Colors in RGB565
    GRAY565 = 0x8410       # #888888
    GREEN565 = 0x2648       # #4CAF50
    YELLOW565 = 0xFE40      # #FFC107
    RED565 = 0xF800         # #F44336
    BLACK565 = 0x0000
    WHITE565 = 0xFFFF
    
    if pct > 60:
        fill565 = GREEN565
    elif pct > 20:
        fill565 = YELLOW565
    else:
        fill565 = RED565
    
    def put_pixel(px_x, py, color):
        if 0 <= px_x < width and 0 <= py < height:
            off = (py * width + px_x) * 2
            buf[off] = (color >> 8) & 0xFF
            buf[off + 1] = color & 0xFF
    
    def draw_rect(px_x1, py1, px_x2, py2, color):
        for py in range(py1, py2):
            for px_x in range(px_x1, px_x2):
                put_pixel(px_x, py, color)
    
    def draw_h_line(px_x1, px_x2, py, color):
        for px_x in range(px_x1, px_x2):
            put_pixel(px_x, py, color)
    
    def draw_v_line(px_x, py1, py2, color):
        for py in range(py1, py2):
            put_pixel(px_x, py, color)
    
    # Battery body outline (2px border)
    # Top edge
    draw_h_line(bx + 2, bx + body_w - 2, by, GRAY565)
    draw_h_line(bx + 1, bx + body_w - 1, by + 1, GRAY565)
    # Bottom edge
    draw_h_line(bx + 2, bx + body_w - 2, by + icon_h - 1, GRAY565)
    draw_h_line(bx + 1, bx + body_w - 1, by + icon_h - 2, GRAY565)
    # Left edge
    draw_v_line(bx, by + 2, by + icon_h - 2, GRAY565)
    draw_v_line(bx + 1, by + 2, by + icon_h - 2, GRAY565)
    # Right edge
    draw_v_line(bx + body_w - 1, by + 2, by + icon_h - 2, GRAY565)
    draw_v_line(bx + body_w - 2, by + 2, by + icon_h - 2, GRAY565)
    # Rounded corners (simplify: fill corners with black background)
    for corner_y in [by, by + 1, by + icon_h - 2, by + icon_h - 1]:
        for corner_x in [bx, bx + 1, bx + body_w - 2, bx + body_w - 1]:
            # Only black out pixels that are at the extreme corners
            if (corner_x in [bx, bx + 1] and corner_y in [by, by + 1]):
                put_pixel(corner_x, corner_y, BLACK565)
            if (corner_x in [bx + body_w - 2, bx + body_w - 1] and corner_y in [by, by + 1]):
                put_pixel(corner_x, corner_y, BLACK565)
            if (corner_x in [bx, bx + 1] and corner_y in [by + icon_h - 2, by + icon_h - 1]):
                put_pixel(corner_x, corner_y, BLACK565)
            if (corner_x in [bx + body_w - 2, bx + body_w - 1] and corner_y in [by + icon_h - 2, by + icon_h - 1]):
                put_pixel(corner_x, corner_y, BLACK565)
    
    # Battery tip
    tip_x = bx + body_w
    tip_w = 4
    tip_h = icon_h // 2
    tip_y = by + tip_h // 2
    draw_rect(tip_x, tip_y, tip_x + tip_w, tip_y + tip_h, GRAY565)
    
    # Fill level
    fm = 3
    fw = int((body_w - 2*fm) * pct / 100)
    if fw > 0:
        draw_rect(bx + fm, by + fm, bx + fm + fw, by + icon_h - fm, fill565)
    
    # Percentage text using simple 5x7 font rendered directly
    text = f"{pct}%"
    # Simple bitmap font (5 wide × 7 tall) — render manually
    FONT_MAP = {
        '0': [0b01110, 0b10001, 0b10011, 0b10101, 0b11001, 0b10001, 0b01110],
        '1': [0b00100, 0b01100, 0b00100, 0b00100, 0b00100, 0b00100, 0b01110],
        '2': [0b01110, 0b10001, 0b00001, 0b00110, 0b01100, 0b10000, 0b11111],
        '3': [0b01110, 0b10001, 0b00001, 0b01110, 0b00001, 0b10001, 0b01110],
        '4': [0b00010, 0b00110, 0b01010, 0b10010, 0b11111, 0b00010, 0b00010],
        '5': [0b11111, 0b10000, 0b11110, 0b00001, 0b00001, 0b10001, 0b01110],
        '6': [0b00110, 0b01000, 0b10000, 0b11110, 0b10001, 0b10001, 0b01110],
        '7': [0b11111, 0b00001, 0b00010, 0b00100, 0b01000, 0b10000, 0b10000],
        '8': [0b01110, 0b10001, 0b10001, 0b01110, 0b10001, 0b10001, 0b01110],
        '9': [0b01110, 0b10001, 0b10001, 0b01111, 0b00001, 0b00010, 0b01100],
        '%': [0b10001, 0b10011, 0b00010, 0b00100, 0b01000, 0b11001, 0b10001],
    }
    text_pixels_w = 0
    for ch in text:
        text_pixels_w += 6 if ch == '%' else 6  # 5 pixels + 1 gap
    text_pixels_w -= 1  # no gap after last char
    text_x = bx + (body_w - text_pixels_w) // 2
    text_y = by + (icon_h - 7) // 2 - 1
    
    for ch in text:
        if ch not in FONT_MAP:
            continue
        glyph = FONT_MAP[ch]
        for row in range(7):
            for col in range(5):
                if glyph[row] & (1 << (4 - col)):
                    px = text_x + col
                    py = text_y + row
                    # Dark outline
                    for dx, dy in [(-1,0),(1,0),(0,-1),(0,1)]:
                        put_pixel(px + dx, py + dy, BLACK565)
                    put_pixel(px, py, WHITE565)
        text_x += 6
    
    return bytes(buf)

