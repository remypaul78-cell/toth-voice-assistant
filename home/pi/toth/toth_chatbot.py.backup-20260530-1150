class AudioRecorder:
    def __init__(self, out, dev="plughw:1,0"):
        self.out = out; self.dev = dev; self.proc = None
    def start(self):
        self.proc = subprocess.Popen(
            ["arecord", "-D", self.dev, "-f", "S16_LE", "-r", str(SAMPLE_RATE),
             "-c", "1", self.out],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            preexec_fn=os.setsid)
        return True
    def stop(self):
        if not self.proc: return False
        try:
            os.killpg(os.getpgid(self.proc.pid), signal.SIGTERM)
            self.proc.wait(timeout=5)
            return os.path.exists(self.out) and os.path.getsize(self.out) > 0
        except Exception:
            try: self.proc.kill()
            except Exception: pass
            return False

def transcribe(path):
    if not os.path.exists(path):
        print(f"[ASR] File not found: {path}")
        return None
    fsize = os.path.getsize(path)
    print(f"[ASR] Transcribing {fsize} bytes via Groq...")
    try:
        with open(path, "rb") as f:
            r = requests.post(
                "https://api.groq.com/openai/v1/audio/transcriptions",
                headers={"Authorization": "Bearer " + G_K},
                files={"file": ("audio.wav", f, "audio/wav")},
                data={"model": "whisper-large-v3", "language": "fr", "response_format": "json"},
                timeout=60)
        print(f"[ASR] HTTP {r.status_code}")
        if r.status_code == 200:
            t = r.json().get("text", "").strip()
            print(f"[ASR] Result: {t[:80]}")
            return t if t else None
        else:
            print(f"[ASR] Error: {r.text[:200]}")
    except Exception as e:
        print(f"[ASR] Exception: {e}")
    return None

def speak(text):
    """Prononce un texte. Coupe la radio si elle joue, puis la relance après."""
    global RADIO_WAS_PLAYING
    if not text:
        return False

    # 1. Stop radio if playing, remember which one
    radio_was_on = os.path.exists(radio_mod.PID_FILE)
    if radio_was_on:
        # Read radio name from state file before stopping
        state_file = "/tmp/toth_radio_state"
        if os.path.exists(state_file):
            with open(state_file) as f:
                RADIO_WAS_PLAYING = f.read().strip()
            print(f"[TTS] Radio {RADIO_WAS_PLAYING} playing — pausing...")
        radio_mod.stop_radio()
        time.sleep(0.5)  # Let audio device release

    print(f"[TTS] Speaking: {text[:80]}...")
    tmp = "/tmp/toth_speech.mp3"
    try:
        import asyncio
        async def s():
            c = Communicate(text, "fr-FR-RemyMultilingualNeural")
            with open(tmp, "wb") as f:
                async for ch in c.stream():
                    if ch["type"] == "audio": f.write(ch["data"])
        asyncio.run(s())
        # Prioritize Bluetooth AirPods, then built-in speaker, then fallback
        airpods_sink = "bluez_output.E4_90_FD_E3_4A_D3.1"
        devices = [
            ("pulse", "PulseAudio (AirPods)"),
            ("hw:1,0", "WM8960 speaker"),
            ("default", "ALSA default"),
        ]
        played = False
        for dev, label in devices:
            # Route PulseAudio to AirPods if they're connected
            if dev == "pulse":
                try:
                    subprocess.run(
                        ["pactl", "set-default-sink", airpods_sink],
                        timeout=3, capture_output=True
                    )
                except Exception:
                    pass
            rr = subprocess.run(["mpg123", "-q", "-a", dev, tmp],
                                timeout=60, capture_output=True)
            if rr.returncode == 0:
                print(f"[TTS] Played on {label}")
                played = True
                break
        if not played:
            print("[TTS] Playback failed on all devices")
    except Exception as e:
        print(f"[TTS] Exception: {e}")
        return False

    # 3. Resume radio if it was playing
    if RADIO_WAS_PLAYING:
        print(f"[TTS] Resuming radio: {RADIO_WAS_PLAYING}")
        radio_mod.play_radio(RADIO_WAS_PLAYING)
        RADIO_WAS_PLAYING = None

    return True

def hermes_ask(question):
    """Send question directly to Hermes Gateway and get response"""
    global SESSION_ID
    try:
        payload = {
            "model": "deepseek-v4-pro",
            "messages": [{"role": "user", "content": question}],
            "stream": False
        }
        if SESSION_ID:
            payload["session_id"] = SESSION_ID
        headers = {
            "Authorization": f"Bearer {HERMES_KEY}",
            "Content-Type": "application/json"
        }
        print(f"[API] POST {HERMES_API}/v1/chat/completions...")
        r = requests.post(
            f"{HERMES_API}/v1/chat/completions",
            json=payload,
            headers=headers,
            timeout=180
        )
        print(f"[API] HTTP {r.status_code}")
        if r.status_code == 200:
            data = r.json()
            # Extract response
            choices = data.get("choices", [])
            if choices:
                content = choices[0].get("message", {}).get("content", "")
                # Save session ID for continuity
                sid = data.get("hermes_session_id") or data.get("session_id")
                if sid:
                    SESSION_ID = sid
                    print(f"[API] Session: {sid}")
                return content.strip() if content else None
            else:
                print("[API] No choices in response")
        else:
            print(f"[API] Error: {r.text[:300]}")
    except Exception as e:
        print(f"[API] Exception: {e}")
    return None

class TothChatbot:
    def __init__(self):
        self.state = STATE_IDLE
        self.board = None; self.rec = None
        self.lock = threading.Lock()
        self._clock_running = False  # Robot clock thread flag
        self._clock_thread = None
        self._batt_timer = None
        print("[TOTH] Initializing WhisplayBoard...")
        self.board = WhisplayBoard()
        self.board.set_backlight(50)
        self.board.on_button_press(self._btn)
        self.board.on_button_release(lambda: None)
        # Start robot clock immediately, no Thoth image
        self._start_clock()
        print("[TOTH] Ready. Hermes direct mode.")

    def _rgb(self, r, g, b):
        try: self.board.set_rgb(r, g, b)
        except Exception: pass

    def _disp(self, text, fs=16):
        """Display text on black background (clock is stopped during interactions)."""
        try:
            from PIL import Image, ImageDraw, ImageFont
            img = Image.new("RGB", (240, 280), "#000000")
            draw = ImageDraw.Draw(img)
            try:
                font = ImageFont.truetype(FONT_PATH, fs)
            except:
                font = ImageFont.load_default()
            words = text.split()
            lines = []; cur = ""
            for w in words:
                t = (cur + " " + w).strip()
                b = draw.textbbox((0, 0), t, font=font)
                if (b[2] - b[0]) > 224:
                    if cur: lines.append(cur)
                    cur = w
                else:
                    cur = t
            if cur: lines.append(cur)
            y = 8
            for line in lines[:14]:
                draw.text((8, y), line, font=font, fill="#FFFFFF")
                y += fs + 2
            data = pil_to_rgb565(img)
            self.board.draw_image(0, 0, 240, 280, data)
        except Exception as e:
            print(f"[DISP] {e}")

    def _start_clock(self):
        """Start robot face loop in background thread."""
        if self._clock_running:
            return
        self._clock_running = True
        self._rgb(0, 0, 0)  # LED off during face display
        def loop():
            while self._clock_running:
                try:
                    data = render_robot_face()
                    self.board.draw_image(0, 0, 240, 280, data)
                except Exception as e:
                    print(f"[FACE] Error: {e}")
                    break
                time.sleep(5)
        self._clock_thread = threading.Thread(target=loop, daemon=True)
        self._clock_thread.start()
        self._batt_timer = threading.Timer(900, self._send_battery_telegram)
        self._batt_timer.daemon = True
        self._batt_timer.start()
        print("[FACE] Started")

    def _stop_clock(self):
        self._clock_running = False
        if self._batt_timer:
            self._batt_timer.cancel()
            self._batt_timer = None

    def _btn(self):
        print(f"[BTN] Press detected, state={self.state}")
        with self.lock: s = self.state
        if s == STATE_IDLE: self._record()
        elif s == STATE_RECORD: self._process()

    def _record(self):
        global RADIO_WAS_PLAYING
        print("[REC] Starting recording...")
        self._stop_clock()
        # Stop radio if playing, remember which one to resume later
        radio_was_on = os.path.exists(radio_mod.PID_FILE)
        if radio_was_on:
            state_file = "/tmp/toth_radio_state"
            if os.path.exists(state_file):
                with open(state_file) as f:
                    RADIO_WAS_PLAYING = f.read().strip()
                print(f"[REC] Radio {RADIO_WAS_PLAYING} playing — stopping for recording...")
            radio_mod.stop_radio()
            time.sleep(0.3)
        with self.lock: self.state = STATE_RECORD
        self._disp("Recording...\nPress again when done.", 16)
        self.rec = AudioRecorder(RECORD_PATH)
        if not self.rec.start():
            self._disp("Mic error"); time.sleep(2)
            self._idle()

    def _process(self):
        print("[PROC] Stopping recording...")
        with self.lock: self.state = STATE_PROCESS
        self._disp("Processing...", 16)
        if self.rec:
            ok = self.rec.stop(); self.rec = None
            if not ok:
                self._disp("Empty recording.\nTry again.")
                time.sleep(2); self._idle(); return
        q = transcribe(RECORD_PATH)
        if not q:
            self._disp("Not understood.\nTry again.")
            time.sleep(2); self._idle(); return
        self._disp("> " + q, 14)
        threading.Thread(target=self._ask_hermes, args=(q,), daemon=True).start()

    def _show_face_override(self, expr_idx, duration=3):
        """Flash a specific expression for duration seconds."""
        try:
            data = render_robot_face(force_expr=expr_idx)
            self.board.draw_image(0, 0, 240, 280, data)
            time.sleep(duration)
        except Exception as e:
            print(f"[FACE] Override error: {e}")

    def _ask_hermes(self, question):
        self._stop_clock()
        # 👀 Big eyes — "message lu"
        self._show_face_override(7, duration=2)
        with self.lock: self.state = STATE_WAITING
        self._disp("Thinking...", 18)
        threading.Thread(target=tg_send, args=("*Question:* " + question,), daemon=True).start()
        answer = hermes_ask(question)
        if answer:
            self._disp(answer, 15)
            threading.Thread(target=tg_send, args=(answer,), daemon=True).start()
            # ❤️ Heart eyes when answer posted
            self._show_face_override(0, duration=4)
            threading.Thread(target=self._speak_and_idle, args=(answer,), daemon=True).start()
        else:
            self._disp("No response. Try again.")
            time.sleep(2)
            self._idle()

    def _speak_and_idle(self, text):
        speak(text)
        self._idle()

    def _idle(self):
        global RADIO_WAS_PLAYING
        print("[IDLE] Returning to idle...")
        with self.lock: self.state = STATE_IDLE
        # Resume radio if it was playing before recording
        if RADIO_WAS_PLAYING:
            print(f"[IDLE] Resuming radio: {RADIO_WAS_PLAYING}")
            radio_mod.play_radio(RADIO_WAS_PLAYING)
            RADIO_WAS_PLAYING = None
        # Restart face loop
        self._start_clock()

    def _send_battery_telegram(self):
        """Send battery status to Telegram chat (not on LCD to avoid flicker)."""
        print("[BATT] Sending battery to Telegram...")
        pct = read_battery()
        if 0 <= pct <= 100:
            emoji = "🔋" if pct > 60 else ("🔶" if pct > 20 else "🪫")
            msg = f"{emoji} Batterie Toth : {pct}%"
        else:
            msg = "⚠️ Batterie Toth : indétectable"
        try:
            url = f"https://api.telegram.org/bot{T_T}/sendMessage"
            requests.post(url, json={"chat_id": T_C, "text": msg}, timeout=5)
            print(f"[BATT] Sent: {msg}")
        except Exception as e:
            print(f"[BATT] Telegram error: {e}")
        # Re-schedule
        if self._batt_timer:
            self._batt_timer.cancel()
        self._batt_timer = threading.Timer(900, self._send_battery_telegram)
        self._batt_timer.daemon = True
        self._batt_timer.start()

    def run(self):
        print("[TOTH] Started (Hermes direct mode).")
        try:
            while True:
                time.sleep(POLL_INT)
        except KeyboardInterrupt:
            print("[TOTH] Shutdown.")
        finally: self._down()

    def _down(self):
        self._rgb(0, 0, 0)
        if self.rec:
            try: self.rec.stop()
            except Exception: pass
        if self.board:
            try: self.board.cleanup()
            except Exception: pass

if __name__ == "__main__":
    if not O_K:
        print("ERROR: no ollama_api_key in config.json"); sys.exit(1)
    TothChatbot().run()
