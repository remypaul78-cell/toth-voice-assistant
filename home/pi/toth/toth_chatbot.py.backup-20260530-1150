def raw565_to_pil(raw, w=240, h=280):
    """Convert RGB565 raw bytes to PIL RGB Image (cached for performance)."""
    img = Image.new("RGB", (w, h))
    px = img.load()
    for y in range(h):
        for x in range(w):
            off = (y * w + x) * 2
            val = (raw[off] << 8) | raw[off + 1]
            r = ((val >> 11) & 0x1F) << 3
            g = ((val >> 5) & 0x3F) << 2
            b = (val & 0x1F) << 3
            px[x, y] = (r, g, b)
    return img

def pil_to_rgb565(img):
    """Convert PIL RGB Image to raw RGB565 bytes."""
    px = img.load()
    buf = bytearray()
    for y in range(img.height):
        for x in range(img.width):
            r, g, b = px[x, y]
            val = (((r >> 3) & 0x1F) << 11) | (((g >> 2) & 0x3F) << 5) | ((b >> 3) & 0x1F)
            buf.append((val >> 8) & 0xFF)
            buf.append(val & 0xFF)
    return bytes(buf)

def render_text_on_bg(bg_pil, text, font_size=16, max_lines=14):
    """Render text over a PIL background image — no black flash."""
    img = bg_pil.copy()
    draw = ImageDraw.Draw(img)
    try:
        font = ImageFont.truetype(FONT_PATH, font_size)
    except Exception:
        font = ImageFont.load_default()
    
    # Draw semi-transparent dark overlay for readability
    overlay = Image.new("RGBA", (240, 280), (0, 0, 0, 140))
    img_rgba = img.convert("RGBA")
    img_rgba.paste(overlay, (0, 0), overlay)
    img = img_rgba.convert("RGB")
    draw = ImageDraw.Draw(img)
    
    # Word wrap
    words = text.split()
    lines = []
    cur = ""
    for w in words:
        t = (cur + " " + w).strip()
        b = draw.textbbox((0, 0), t, font=font)
        if (b[2] - b[0]) > 224:
            if cur:
                lines.append(cur)
            cur = w
        else:
            cur = t
    if cur:
        lines.append(cur)
    lines = lines[:max_lines]
    
    y = 8
    for line in lines:
        draw.text((8, y), line, font=font, fill="#FFFFFF")
        y += font_size + 2
    
    return pil_to_rgb565(img)


