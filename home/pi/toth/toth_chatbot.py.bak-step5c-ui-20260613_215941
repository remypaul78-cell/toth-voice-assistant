class AudioRecorder:
    """Streaming recorder: sends 2s chunks to Groq Whisper, accumulates text, displays live on LCD."""
    def __init__(self, dev="plughw:0,0", chunk_sec=2.0):
        self.dev = dev
        self.chunk_sec = chunk_sec
        self.proc = None
        self.accumulated_text = ""
        self._running = False
        self._stream_thread = None
        self._on_text = None  # callback(text) for live display
        self._last_text = ""  # anti-duplicate

    def start(self, on_text_callback):
        """Start recording + streaming transcription. on_text_callback(text) called with accumulated text."""
        self._on_text = on_text_callback
        self.accumulated_text = ""
        self._last_text = ""
        self._running = True
        # arecord → pipe (16-bit mono 16kHz, raw PCM)
        self.proc = subprocess.Popen(
            ["arecord", "-D", self.dev, "-f", "S16_LE", "-r", str(SAMPLE_RATE),
             "-c", "1", "-t", "raw", "-"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            preexec_fn=os.setsid)
        self._stream_thread = threading.Thread(target=self._stream_loop, daemon=True)
        self._stream_thread.start()
        return True

    def _stream_loop(self):
        """Collecte tout l'audio, affiche 'Parlez...' live, envoie global à Groq.
        Moins de requêtes, plus fiable."""
        import select
        chunk_bytes = int(SAMPLE_RATE * 2 * self.chunk_sec)
        all_data = b""
        fd = self.proc.stdout.fileno()
        while self._running:
            try:
                ready, _, _ = select.select([fd], [], [], 0.3)
                if not ready:
                    continue
                chunk = os.read(fd, 8192)
                if not chunk:
                    break
                all_data += chunk
            except Exception as e:
                print(f"[STREAM] Error: {e}")
                break
        # Sauvegarder tout l'audio
        self._raw_audio = all_data
        print(f"[STREAM] Total audio: {len(all_data)} bytes")

    def _transcribe_all(self):
        """Transcrit l'audio complet avec filtres simples + RNNoise."""
        if not self._raw_audio:
            return ""
        # Vérifier niveau audio minimum
        import math
        samples = struct.unpack(f"<{len(self._raw_audio)//2}h", self._raw_audio[:len(self._raw_audio)//2*2])
        if not samples:
            return ""
        rms = math.sqrt(sum(s*s for s in samples) / len(samples))
        print(f"[STREAM] Global RMS={rms:.0f}")
        if rms < 300:
            print("[STREAM] Audio trop faible")
            return ""
        # Écrire wav brut
        raw_wav = "/tmp/toth_full_raw.wav"
        clean_wav = "/tmp/toth_full_clean.wav"
        self._write_wav(raw_wav, self._raw_audio)
        # Filtres simples : high-pass 200Hz + normalize + RNNoise
        try:
            import subprocess as _sp
            _sp.run([
                "ffmpeg", "-y", "-i", raw_wav,
                "-af", "highpass=f=200,arnndn,loudnorm=I=-16:LRA=11:TP=-1.5",
                "-ar", "16000", "-ac", "1", clean_wav
            ], stdout=_sp.DEVNULL, stderr=_sp.DEVNULL, timeout=10)
            if __import__('os').path.exists(clean_wav) and __import__('os').path.getsize(clean_wav) > 0:
                print("[FILTER] Audio filtre et nettoye")
                return self._groq_transcribe(clean_wav)
        except Exception as e:
            print(f"[FILTER] error: {e}")
        # Fallback
        return self._groq_transcribe(raw_wav)

    def _write_wav(self, path, pcm_data):
        """Write raw PCM to a minimal WAV file."""
        with open(path, "wb") as f:
            # RIFF header
            ds = len(pcm_data)
            f.write(b"RIFF")
            f.write(struct.pack("<I", 36 + ds))
            f.write(b"WAVE")
            # fmt chunk
            f.write(b"fmt ")
            f.write(struct.pack("<I", 16))        # chunk size
            f.write(struct.pack("<H", 1))          # PCM
            f.write(struct.pack("<H", 1))          # mono
            f.write(struct.pack("<I", SAMPLE_RATE))
            f.write(struct.pack("<I", SAMPLE_RATE * 2))  # byte rate
            f.write(struct.pack("<H", 2))          # block align
            f.write(struct.pack("<H", 16))         # bits per sample
            # data chunk
            f.write(b"data")
            f.write(struct.pack("<I", ds))
            f.write(pcm_data)

    def _groq_transcribe(self, path):
        """Transcribe a single audio chunk via Groq Whisper."""
        try:
            with open(path, "rb") as f:
                r = requests.post(
                    "https://api.groq.com/openai/v1/audio/transcriptions",
                    headers={"Authorization": "Bearer " + G_K},
                    files={"file": ("chunk.wav", f, "audio/wav")},
                    data={"model": "whisper-large-v3", "language": "fr", "response_format": "json", "prompt": _WHISPER_PROMPT, "temperature": "0.0"},
                    timeout=60)
            if r.status_code == 200:
                t = r.json().get("text", "").strip()
                return t if t else ""
        except Exception as e:
            print(f"[GROQ] Chunk error: {e}")
        return ""

    def stop(self):
        """Stop recording and transcribe full audio."""
        self._running = False
        if self.proc:
            try:
                os.killpg(os.getpgid(self.proc.pid), signal.SIGTERM)
                self.proc.wait(timeout=3)
            except Exception:
                try:
                    self.proc.kill()
                except Exception:
                    pass
        if self._stream_thread and self._stream_thread.is_alive():
            self._stream_thread.join(timeout=5)
        text = self._transcribe_all()
        self.accumulated_text = text
        return text.strip()

def transcribe(path):
    if not os.path.exists(path):
        print(f"[ASR] File not found: {path}")
        return None
    fsize = os.path.getsize(path)
    print(f"[ASR] Transcribing {fsize} bytes via Groq...")
    try:
        with open(path, "rb") as f:
            r = requests.post(
                "https://api.groq.com/openai/v1/audio/transcriptions",
                headers={"Authorization": "Bearer " + G_K},
                files={"file": ("audio.wav", f, "audio/wav")},
                data={"model": "whisper-large-v3", "language": "fr", "response_format": "json", "prompt": _WHISPER_PROMPT, "temperature": "0.0"},
                timeout=60)
        print(f"[ASR] HTTP {r.status_code}")
        if r.status_code == 200:
            t = r.json().get("text", "").strip()
            print(f"[ASR] Result: {t[:80]}")
