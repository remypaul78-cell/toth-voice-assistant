    return None

def clean_for_tts(text):
    """Nettoie le markdown et la ponctuation excessive pour le TTS vocal.
    edge-tts lit tout littéralement — **gras** devient 'astérisque astérisque gras astérisque astérisque'."""
    import re
    # Liens markdown [texte](url) → texte
    text = re.sub(r'\[([^\]]+)\]\([^)]+\)', r'\1', text)
    # Gras **texte** ou __texte__
    text = re.sub(r'\*\*([^*]+)\*\*', r'\1', text)
    text = re.sub(r'__([^_]+)__', r'\1', text)
    # Italique *texte* ou _texte_ (attention aux astérisques isolés)
    text = re.sub(r'\*([^*]+)\*', r'\1', text)
    text = re.sub(r'(?<!\w)_([^_]+)_(?!\w)', r'\1', text)
    # Headers # ## ###
    text = re.sub(r'^#{1,6}\s+', '', text, flags=re.MULTILINE)
    # Listes - * •
    text = re.sub(r'^[\s]*[-*•]\s+', '• ', text, flags=re.MULTILINE)
    # Backticks `code` et ```blocks```
    text = re.sub(r'```[\s\S]*?```', '', text)
    text = re.sub(r'`([^`]+)`', r'\1', text)
    # Sauts de ligne multiples → un seul
    text = re.sub(r'\n{2,}', '. ', text)
    text = re.sub(r'\n', ' ', text)
    # Espaces multiples
    text = re.sub(r' {2,}', ' ', text)
    # Strikethrough ~~texte~~
    text = re.sub(r'~~([^~]+)~~', r'\1', text)
    # Emojis custom :name:
    text = re.sub(r':[a-z_]+:', '', text)
    return text.strip()

def speak(text, cancel_check=None, display_cb=None):
    """Prononce un texte phrase par phrase. Coupe la radio si elle joue.
    Chaque phrase = un MP3 séparé → évite les crashs OOM/edge-tts sur les longs textes.
    display_cb(full_text, batch_idx, total_batches) appelé avant chaque phrase pour le scroll LCD.
    Returns False if cancelled mid-speech."""
    global RADIO_WAS_PLAYING
    if not text:
        return False

    global _TTS_PROC
    _TTS_PROC = None
    import asyncio, re

    # Split into sentences: split after .!?» followed by whitespace
    sentences = re.split(r'(?<=[.!?»])\s+', text)
    # Merge back tiny fragments (e.g. "M." or "Dr." got split)
    merged = []
    for s in sentences:
        s = s.strip()
        if not s:
            continue
        if merged and len(merged[-1]) < 8 and merged[-1][-1] not in '.!?»':
            merged[-1] = merged[-1] + " " + s
        else:
            merged.append(s)
    sentences = merged

    # 1. Stop radio if playing (once, not per sentence)
    radio_was_on = os.path.exists(radio_mod.PID_FILE)
    if radio_was_on:
        state_file = "/tmp/toth_radio_state"
        if os.path.exists(state_file):
            with open(state_file) as f:
                RADIO_WAS_PLAYING = f.read().strip()
            print(f"[TTS] Radio {RADIO_WAS_PLAYING} playing — pausing...")
        radio_mod.stop_radio()
        time.sleep(0.5)

    # Group sentences into batches of ~4, synthesized as ONE MP3 per batch
    BATCH_SIZE = 3  # 3 phrases par batch → moins de pauses entre les groupes
    batches = [sentences[i:i+BATCH_SIZE] for i in range(0, len(sentences), BATCH_SIZE)]

    print(f"[TTS] Speaking {len(sentences)} sentences → {len(batches)} batch(es): {text[:80]}...")

    # Route PulseAudio to AirPods once
    airpods_sink = "bluez_output.E4_90_FD_E3_4A_D3.1"
    try:
        subprocess.run(
            ["pactl", "set-default-sink", airpods_sink],
            timeout=3, capture_output=True
        )
    except Exception:
        pass

    # Device fallback: pulse → hw:0,0 → default (found once, reused)
    devices = [
        ("pulse", "PulseAudio (AirPods)"),
        ("default", "WM8960 speaker"),
        ("default", "ALSA default"),
    ]
    play_dev = "default"
    for dev, label in devices:
        try:
            test = subprocess.run(
                ["mpg123", "-t", "-q", "-a", dev],
                timeout=3, capture_output=True
            )
            play_dev = dev
            print(f"[TTS] Device: {label}")
            break
        except Exception:
            continue

    played_any = False
    for batch_idx, batch in enumerate(batches):
        # Check cancel flag between batches
        if cancel_check and cancel_check():
            print(f"[TTS] Cancelled before batch {batch_idx+1}")
            break

        batch_text = ". ".join(s.strip() for s in batch if s.strip()) + "."

        tmp = f"/tmp/toth_speech_b{batch_idx}.mp3"

        try:
            # Synthesize entire batch as one MP3
            async def synthesize():
                c = Communicate(batch_text, "fr-FR-RemyMultilingualNeural")
                with open(tmp, "wb") as f:
                    async for ch in c.stream():
                        if ch["type"] == "audio":
                            f.write(ch["data"])
            asyncio.run(synthesize())

            # Measure MP3 duration for scroll speed
            duration = 0
            try:
                import json
                r = subprocess.run(
                    ["ffprobe", "-v", "quiet", "-print_format", "json",
                     "-show_format", tmp],
                    capture_output=True, text=True, timeout=5)
                if r.returncode == 0:
                    info = json.loads(r.stdout)
                    duration = float(info.get("format", {}).get("duration", 0))
            except Exception:
                pass
            if duration <= 0:
                # Fallback: estimate from char count (~13 chars/sec French TTS)
                duration = max(1.0, len(batch_text) / 13.0)

            # Update LCD scroll with actual duration BEFORE playing
            if display_cb:
                try:
                    display_cb(text, batch_idx, len(batches), duration)
                except Exception as e:
                    print(f"[TTS] display_cb error: {e}")

            # Convert MP3 to WAV (ALSA direct playback is more reliable)
            wav_tmp = tmp.replace(".mp3", ".wav")
            subprocess.run(
                ["ffmpeg", "-y", "-i", tmp, "-ar", "44100", "-ac", "2", wav_tmp],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                timeout=15
            )
            # Max volume pour TTS (Rémy entend mal sinon)
            os.popen("amixer -c 0 set Speaker 127")
            # Play WAV via aplay direct to WM8960 (bypass PulseAudio)
            _TTS_PROC = subprocess.Popen(
                ["aplay", "-q", "-D", "plughw:0,0", wav_tmp],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                preexec_fn=os.setsid
            )
            rc = _TTS_PROC.wait(timeout=120)
            if rc == 0:
                played_any = True
            elif rc == -15:
                print(f"[TTS] Batch {batch_idx+1} cancelled")
                _TTS_PROC = None
                return False
            else:
                print(f"[TTS] Batch {batch_idx+1} failed (rc={rc})")
        except subprocess.TimeoutExpired:
            print(f"[TTS] Batch {batch_idx+1} timed out")
            try:
                if _TTS_PROC and _TTS_PROC.poll() is None:
                    os.killpg(os.getpgid(_TTS_PROC.pid), signal.SIGTERM)
            except Exception:
                pass
        except Exception as e:
            print(f"[TTS] Batch {batch_idx+1} error: {e}")

    _TTS_PROC = None

    # 3. Resume radio if it was playing
    if RADIO_WAS_PLAYING:
        print(f"[TTS] Resuming radio: {RADIO_WAS_PLAYING}")
        radio_mod.play_radio(RADIO_WAS_PLAYING)
        RADIO_WAS_PLAYING = None
    else:
        # Retour volume 30% apres parole (anti-Larsen)
        os.popen("amixer -c 0 set Speaker 38")

    if played_any:
        print("[TTS] All sentences played")
        return True
    else:
        print("[TTS] No sentences played")
        return False

