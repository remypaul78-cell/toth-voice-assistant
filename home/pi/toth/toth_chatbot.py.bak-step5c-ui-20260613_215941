    def _ring_action(self, action):
        try:
            if action == "record":
                if self._menu_items[self._menu_idx] == "MEDIA":
                    if not self._media_inside:
                        self._media_inside = True
                        self._media_submenu_idx = 0
                        self._show_menu(self._menu_idx)
                        return
                    tab = self._media_tabs[self._media_submenu_idx % len(self._media_tabs)]
                    if tab == "RADIO":
                        self._ring_radio_toggle()
                    elif tab == "MUSIQUE":
                        import subprocess
                        try: subprocess.run(["playerctl", "play-pause"], timeout=3)
                        except Exception as e: print(f"[MEDIA] play-pause error: {e}")
                    elif tab == "BOUQUIN":
                        if self._book_mode == "chapters":
                            if self._book_chapter_idx == -1:
                                self._book_mode = "book"
                            else:
                                self._book_char_pos = 0
                                self._save_book_state()
                                self._book_mode = "book"
                            threading.Thread(target=self._book_speak_chunk, daemon=True).start()
                            self._show_menu(self._menu_idx)
