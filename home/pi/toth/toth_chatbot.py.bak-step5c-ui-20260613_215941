    def _load_books(self):
        # Discover JSON books in /home/pi/toth/books/
        try:
            files = [f for f in os.listdir(self._books_dir) if f.endswith(".json")]
            self._books = []
            for fn in sorted(files):
                fp = os.path.join(self._books_dir, fn)
                with open(fp, "r", encoding="utf-8") as f:
                    data = json.load(f)
                self._books.append({
                    "file": fn,
                    "title": data.get("title", fn),
                    "author": data.get("author", ""),
                    "chapters": data.get("chapters", [])
                })
            print(f"[BOOKS] Loaded {len(self._books)} books")
        except Exception as e:
            print(f"[BOOKS] load error: {e}")
        # Load saved position
        try:
            if os.path.exists(self._books_saved):
                with open(self._books_saved, "r") as f:
                    s = json.load(f)
                self._book_idx = s.get("book_idx", 0)
                self._book_chapter_idx = s.get("chapter_idx", 0)
                self._book_char_pos = s.get("char_pos", 0)
        except Exception:
            pass

    def _save_book_state(self):
        try:
            s = {"book_idx": self._book_idx, "chapter_idx": self._book_chapter_idx, "char_pos": self._book_char_pos}
            with open(self._books_saved, "w") as f:
                json.dump(s, f)
        except Exception as e:
            print(f"[BOOKS] save error: {e}")

    def _book_get_current_text(self):
        if not self._books or self._book_idx >= len(self._books):
            return ""
        book = self._books[self._book_idx]
        chs = book["chapters"]
        if self._book_chapter_idx >= len(chs):
            return ""
        text = chs[self._book_chapter_idx].get("text", "")
        return text

    def _book_next_chunk(self):
        text = self._book_get_current_text()
        if not text:
            return ""
        # Return chunk from current pos, ~400 chars
        chunk = text[self._book_char_pos:self._book_char_pos + 400]
        return chunk.strip()

    def _book_advance(self, chars):
        text = self._book_get_current_text()
        self._book_char_pos = min(len(text), self._book_char_pos + chars)
        self._save_book_state()

    def _book_rewind_chapter(self):
        self._book_char_pos = 0
        self._save_book_state()

    def _book_next_chapter(self):
        if not self._books or self._book_idx >= len(self._books):
            return
        chs = self._books[self._book_idx]["chapters"]
        if self._book_chapter_idx + 1 < len(chs):
            self._book_chapter_idx += 1
            self._book_char_pos = 0
            self._save_book_state()

    def _book_prev_chapter(self):
        if self._book_chapter_idx > 0:
            self._book_chapter_idx -= 1
            self._book_char_pos = 0
            self._save_book_state()

    def _book_suggest(self):
        import random
        if not self._books or self._book_idx >= len(self._books):
            return ""
        chs = self._books[self._book_idx]["chapters"]
        if not chs:
            return ""
        idx = random.randint(0, len(chs) - 1)
        self._book_chapter_idx = idx
        self._book_char_pos = 0
        self._save_book_state()

    def _book_speak_chunk(self):
        """Toggle play/pause pour la lecture audio."""
        if self._book_is_playing:
            self._book_stop()
            return
        chunk = self._book_next_chunk()
        if not chunk:
            return
        self._book_is_playing = True
        self._book_last_text = chunk
        try:
            tmp_mp3 = "/tmp/toth_book.mp3"
            tmp_wav = "/tmp/toth_book.wav"
            from edge_tts import Communicate
            import asyncio
            async def synth():
                com = Communicate(chunk, "fr-FR-DeniseNeural", rate="+0%", volume="+0%", pitch="+0Hz")
                await com.save(tmp_mp3)
            asyncio.run(synth())
            subprocess.run(["ffmpeg", "-y", "-i", tmp_mp3, "-ar", "22050", "-ac", "1", tmp_wav], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if os.path.exists(tmp_wav) and self._book_is_playing:
                self._book_proc = subprocess.Popen(["aplay", tmp_wav], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self._book_proc.wait()
                if self._book_is_playing:
                    self._book_advance(len(chunk))
        except Exception as e:
            print(f"[BOOK TTS] error: {e}")
        finally:
            self._book_is_playing = False
            self._book_proc = None

    def _book_stop(self):
        try:
            if self._book_proc and self._book_proc.poll() is None:
                self._book_proc.terminate()
                try:
                    self._book_proc.wait(timeout=0.5)
                except Exception:
                    self._book_proc.kill()
        except Exception:
            pass
        self._book_is_playing = False
        self._book_proc = None

    def _play_wav_bytes(self, data):
        """Play raw wav bytes via aplay if available, else speaker-test fallback."""
        try:
            # Write to temp file and play
            wf = "/tmp/toth_play.wav"
            with open(wf, "wb") as f:
                f.write(data)
            subprocess.run(["aplay", wf], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
        except Exception:
            # Fallback: just log
            pass
