    # ── Ring (JX‑05 Bluetooth) ────────────────────────────────────────
    def _find_ring_device(self):
        """Find the JX‑05 trackpad input event device. Returns path or None."""
        try:
            with open("/proc/bus/input/devices") as f:
                content = f.read()
            # Look for the trackpad block, not the Consumer Control keyboard
            # Entry has: N: Name="JX-05" (not "JX-05 Consumer Control")
            #            H: Handlers=mouse0 eventN
            for block in content.split("\n\n"):
                lines = block.strip().split("\n")
                name_line = [l for l in lines if l.startswith("N: Name=")]
                handlers_line = [l for l in lines if l.startswith("H: Handlers=")]
                if name_line and handlers_line:
                    name = name_line[0].split("=", 1)[1].strip().strip('"')
                    handlers = handlers_line[0].split("=", 1)[1].strip()
                    if name == "JX-05" and "mouse" in handlers:
                        for part in handlers.split():
                            if part.startswith("event"):
                                path = "/dev/input/" + part
                                print(f"[RING] Found device: {path}")
                                return path
        except Exception as e:
            print(f"[RING] Device scan failed: {e}")
        return None

    
    def _ring_watcher(self):
        """Listen to JX-05 ring events and dispatch actions.
        
        JX-05 sends all events on event1 (trackpad):
        - MIDDLE CLICK: BTN_TOUCH + TRACKING_ID + positions, short (<400ms), NO swipe
        - HAUT/BAS/GAUCHE/DROITE: swipe (touch + movement + release)
        - Double-tap: 2 quick touches (<600ms apart)
        - Long-press HAUT/BAS: hold >400ms = volume ramp
        
        Detection strategy:
        - Record x,y on ABS_MT_POSITION_X/Y
        - On BTN_TOUCH=1: start timer
        - On BTN_TOUCH=0: if hold < LONG_THRESH and positions exist but no movement -> middle click
          else -> calculate swipe direction from first touch position
        """
        x_first = y_first = None      # First position of current touch
        x_last = y_last = None        # Last position of current touch
        x_pos = y_pos = None          # Current position being read
        last_touch_up = 0             # Timestamp of last BTN_TOUCH=0
        touch_start = 0               # Timestamp of BTN_TOUCH=1
        touch_active = False          # Currently touching
        had_position = False          # Did we get at least one position during this touch?
        DBL_THRESH = 0.6              # Double-tap window in seconds
        LONG_THRESH = 0.4             # Long-press threshold (>400ms)
        SWIPE_DIST = 200              # Min pixel delta for swipe detection
        LONG_ACTION_SENT = False
        LONG_LAST_TICK = 0
        RAMP_INTERVAL = 0.3

        while True:
            # Re-scan device path chaque boucle — le device peut changer
            dev = self._find_ring_device()
            if not dev:
                print("[RING] Waiting for JX-05 device...")
                time.sleep(3)
                continue
            if dev != self._ring_dev:
                print(f"[RING] Device changed: {self._ring_dev} -> {dev}")
                self._ring_dev = dev

            print(f"[RING] Connecting to {self._ring_dev}...")
            try:
                fd = os.open(self._ring_dev, os.O_RDONLY)
            except Exception as e:
                print(f"[RING] Cannot open {self._ring_dev}: {e}")
                time.sleep(3)
                continue

            print(f"[RING] Watching {self._ring_dev}")
            try:
                while True:
                    data = os.read(fd, 24)
                    tv_sec, tv_usec, typ, code, value = struct.unpack('llHHi', data)
                    t_now = tv_sec + tv_usec * 1e-6

                    # BTN_TOUCH (code 330)
                    if typ == 1 and code == 330:
                        if value == 1:
                            self._wake_screen()
                            touch_start = t_now
                            touch_active = True
                            LONG_ACTION_SENT = False
                            x_last = y_last = x_pos = y_pos = None
                            had_position = False
                            # Ne PAS reset x_first/y_first — coords peuvent arriver AVANT BTN_TOUCH
                        elif value == 0:
                            if touch_active:
                                dt_hold = t_now - touch_start
                                dt_since_last = t_now - last_touch_up
                                last_touch_up = t_now
                                touch_active = False

                                if not had_position:
                                    # No position at all — treat as middle click
                                    print(f"[RING] Middle click (no pos, hold={dt_hold:.3f}s)")
                                    self._ring_action("record")

                                elif x_first is not None:
                                    # Calculate swipe distance (fix: bague n'envoie parfois que X)
                                    dx = (x_last or x_first) - x_first
                                    dy = ((y_last or y_first) - y_first) if y_last is not None and y_first is not None else 0
                                    dist = abs(dx) + abs(dy)

                                    # Double-tap check
                                    if 0 < dt_since_last < DBL_THRESH:
                                        print(f"[RING] Double-tap detected")
                                        self._ring_action("radio_toggle")

                                    elif dist < SWIPE_DIST and dt_hold < LONG_THRESH:
                                        # Short tap = check zone (haut/bas/gauche/droite/centre)
                                        if x_first is not None:
                                            zone = self._ring_zone(x_first, y_first)
                                            if zone in ("haut", "bas", "gauche", "droite"):
                                                print(f"[RING] Zone {zone.upper()} (x={x_first} y={y_first})")
                                                self._ring_action(zone)
                                            else:
                                                print(f"[RING] Middle click (tap, x={x_first} y={y_first}, hold={dt_hold:.3f}s)")
                                                self._ring_action("record")
                                        else:
                                            print(f"[RING] Middle click (tap, x={x_first} y={y_first}, hold={dt_hold:.3f}s)")
                                            self._ring_action("record")

                                    elif dist >= SWIPE_DIST and dt_hold < LONG_THRESH * 3:
                                        # Swipe: determine direction
                                        if abs(dx) > abs(dy):
                                            if dx > 0:
                                                print(f"[RING] Swipe RIGHT (dx={dx})")
                                                self._ring_action("droite")
                                            else:
                                                print(f"[RING] Swipe LEFT (dx={dx})")
                                                self._ring_action("gauche")
                                        else:
                                            if dy > 0:
                                                print(f"[RING] Swipe DOWN (dy={dy})")
                                                self._ring_action("bas")
                                            else:
                                                print(f"[RING] Swipe UP (dy={dy})")
                                                self._ring_action("haut")

                                    # Long-press release — no single-click action

                    # ABS_MT_POSITION_X (code 53)
                    elif typ == 3 and code == 53:
                        x_pos = value
                        if x_first is None:
                            x_first = value
                        x_last = value
                        had_position = True

                    # ABS_MT_POSITION_Y (code 54)
                    elif typ == 3 and code == 54:
                        y_pos = value
                        if y_first is None:
                            y_first = value
                        y_last = value
                        had_position = True

                    # ABS_MT_TRACKING_ID (code 57) — ignore, we use our own state machine
                    elif typ == 3 and code == 57:
                        pass

                    # Long-press ramp while holding a direction
                    if touch_active and had_position and x_first is not None and y_first is not None:
                        dt_hold = t_now - touch_start
                        if dt_hold > LONG_THRESH and t_now - LONG_LAST_TICK > RAMP_INTERVAL:
                            zone = self._ring_zone(x_first, y_first)
                            if zone == "volume_up":
                                self._ring_action("volume_up")
                            elif zone == "volume_down":
                                self._ring_action("volume_down")
                            LONG_LAST_TICK = t_now
                            LONG_ACTION_SENT = True
            except OSError:
                    print("[RING] Device disconnected — reconnecting in 2s...")
                    try: os.close(fd)
                    except Exception: pass
                    time.sleep(2)


    
    def _ring_zone(self, x, y):
        """Map X,Y touch coordinates to a button zone.
        JX-05 pad is 0-4095 in both axes.
        Calibrated 7 June 2026: HAUT Y=1012, BAS Y=2000-2300, GAUCHE X=436, DROITE X=1877.
        Returns 'haut', 'bas', 'gauche', 'droite', or None.
        """
        if x is not None:
            if x < 800:
                return "gauche"
            if x > 1400:
                return "droite"
        if y is not None:
            if y < 1200:
                return "haut"
            if y > 1800:
                return "bas"
        return None

