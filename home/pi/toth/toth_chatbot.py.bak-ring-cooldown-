            self._missive_preview = ""
            self._show_menu(self._menu_idx)

    def _missive_tts(self, text):
        """Joue reponse TTS localement."""
        import subprocess, tempfile, os
        try:
            fd, mp3 = tempfile.mkstemp(suffix=".mp3")
            os.close(fd)
            # Generer TTS avec edge-tts
            subprocess.run(
                ["edge-tts", "--text", text[:200], "--write-media", mp3],
