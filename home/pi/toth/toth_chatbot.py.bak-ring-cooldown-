    def _missive_record_task(self):
        """Enregistre audio et transcrit quand stop demande."""
        import subprocess, tempfile, os, requests
        try:
            fd, path = tempfile.mkstemp(suffix=".wav")
            os.close(fd)
            # Enregistrement continu jusqu'a _missive_state != "recording"
            proc = subprocess.Popen(
                ["arecord", "-D", "plughw:1,0", "-f", "S16_LE", "-r", "16000", "-c", "1", path],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            while proc.poll() is None and self._missive_state == "recording":
                time.sleep(0.2)
            proc.terminate()
            try:
                proc.wait(timeout=2)
            except:
                proc.kill()
            # Si on est en preview, transcrire
            if self._missive_state == "preview" and os.path.getsize(path) > 1000:
                # Transcription via Whisper (Groq)
                try:
                    with open(path, "rb") as af:
                        resp = requests.post(
                            "https://api.groq.com/openai/v1/audio/transcriptions",
                            headers={"Authorization": "Bearer " + os.environ.get("GROQ_KEY", "")},
                            files={"file": ("audio.wav", af, "audio/wav")},
                            data={"model": "whisper-large-v3", "language": "fr", "response_format": "json", "prompt": _WHISPER_PROMPT, "temperature": "0.0"},
                            timeout=10)
                    if resp.status_code == 200:
                        self._missive_preview = resp.json().get("text", "?")
                    else:
                        self._missive_preview = f"Err {resp.status_code}"
                except Exception as e:
                    self._missive_preview = f"Err: {e}"
                self._show_menu(self._menu_idx)
        finally:
            try:
                os.unlink(path)
            except: pass

    def _missive_send_to_hermes(self, text):
        """Envoie message a Hermes, recupere reponse TTS locale."""
        import requests
        try:
            payload = {"message": text, "session_id": self._session_id if hasattr(self, '_session_id') else "toth"}
            resp = requests.post(
