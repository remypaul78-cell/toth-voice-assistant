    def _ask_hermes_telegram(self, question, timeout=120):
        """Envoie la question au bot Hermes via Telegram et attend la réponse texte."""
        if not self._bridge or not self._bridge.ready:
            self._disp("Telegram non pret", 18)
            return None
        # Vide la queue des anciennes réponses
        while not self._telegram_queue.empty():
            try:
                self._telegram_queue.get_nowait()
            except Exception:
                break
        self._bridge.send_question(question)
        self._disp("Attente Hermes...", 18)
        try:
            return self._telegram_queue.get(timeout=timeout)
        except queue.Empty:
            return None

    def _ask_hermes(self, question, extra_instruction=None):
        self._stop_clock()
        self._cancel_flag = False
        with self.lock: self.state = STATE_WAITING
        threading.Thread(target=tg_send, args=("🏴‍☠️ Rémy 🏴‍☠️ " + question,), daemon=True).start()
        
        # Write waiting timestamp — watchdog can detect if we're stuck
        try:
            with open("/tmp/toth_waiting_since", "w") as f:
                f.write(str(time.time()))
        except Exception:
            pass
        
        # Single attempt — no auto-retry loop.
        # If Hermes doesn't answer in CALL_TIMEOUT, tell user and go idle.

        CALL_TIMEOUT = 120  # 120 secondes max
        
        if self._cancel_flag:
            print("[QUEUE] Cancelled before attempt")
            try:
                os.remove("/tmp/toth_waiting_since")
            except Exception:
                pass
            self._idle()
            return
        
        # Question stays visible — no overlay

        # Appel avec 1 retry si échec
        answer, sid = hermes_ask(question, timeout=CALL_TIMEOUT, extra_instruction=extra_instruction)
        if not answer and not self._cancel_flag:
            print("[ASK] Retry after 3s...")
            time.sleep(3)
            answer, sid = hermes_ask(question, timeout=CALL_TIMEOUT)
        
        if self._cancel_flag:
            print("[ASK] Cancelled after Hermes call")
            try: os.remove("/tmp/toth_waiting_since")
            except Exception: pass
            self._idle()
            return
        
        if answer:
            # Got a response — clear pending question
            self._pending_question = None
            # Write last response timestamp — watchdog sees we're alive
            try:
                with open("/tmp/toth_last_response", "w") as f:
                    f.write(str(time.time()))
                os.remove("/tmp/toth_waiting_since")
            except Exception:
                pass
            # Show answer — adaptive font size: bigger for short text
            answer_len = len(answer)
            if answer_len <= 10:
                fs = 48
            elif answer_len <= 25:
                fs = 36
            elif answer_len <= 50:
                fs = 30
            elif answer_len <= 100:
                fs = 26
            else:
                fs = 22
            # Check cancel flag again before speaking
            if not self._cancel_flag:
                threading.Thread(target=self._speak_and_idle, args=(answer,), daemon=True).start()
            else:
                print("[ASK] Cancelled — answer shown but no TTS")
                self._idle()
        else:
            # Timeout or API error — go idle silently
            try:
                os.remove("/tmp/toth_waiting_since")
            except Exception:
                pass
            self._pending_question = None  # nettoyer pour éviter résurgence
            print(f"[ASK] No answer — going idle silently")
            self._idle()

    def _speak_and_idle(self, text):
        speak(clean_for_tts(text),
