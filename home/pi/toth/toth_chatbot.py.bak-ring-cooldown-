            except: pass
            try:
                self._net_tailscale_ip = subprocess.check_output(["tailscale", "ip", "-4"]).decode().strip().split()[0]
            except: pass
            try:
                ssid = subprocess.check_output(["iwgetid", "-r"]).decode().strip()
                self._net_wifi_ssid = ssid if ssid else "?"
            except: pass
            try:
                out = subprocess.check_output(["systemctl", "is-active", "tailscaled"]).decode().strip()
                self._net_tailscale_on = (out == "active")
            except Exception:
                self._net_tailscale_on = False
            time.sleep(10)


    def _load_books(self):
        # Discover JSON books in /home/pi/toth/books/
        try:
            files = [f for f in os.listdir(self._books_dir) if f.endswith(".json")]
            self._books = []
            for fn in sorted(files):
                fp = os.path.join(self._books_dir, fn)
                with open(fp, "r", encoding="utf-8") as f:
                    data = json.load(f)
                self._books.append({
                    "file": fn,
                    "title": data.get("title", fn),
                    "author": data.get("author", ""),
                    "chapters": data.get("chapters", [])
                })
            print(f"[BOOKS] Loaded {len(self._books)} books")
        except Exception as e:
            print(f"[BOOKS] load error: {e}")
        # Load saved position
        try:
            if os.path.exists(self._books_saved):
                with open(self._books_saved, "r") as f:
                    s = json.load(f)
                self._book_idx = s.get("book_idx", 0)
                self._book_chapter_idx = s.get("chapter_idx", 0)
                self._book_char_pos = s.get("char_pos", 0)
        except Exception:
            pass

    def _save_book_state(self):
        try:
            s = {"book_idx": self._book_idx, "chapter_idx": self._book_chapter_idx, "char_pos": self._book_char_pos}
            with open(self._books_saved, "w") as f:
                json.dump(s, f)
        except Exception as e:
            print(f"[BOOKS] save error: {e}")

    def _book_get_current_text(self):
        if not self._books or self._book_idx >= len(self._books):
            return ""
        book = self._books[self._book_idx]
        chs = book["chapters"]
        if self._book_chapter_idx >= len(chs):
            return ""
        text = chs[self._book_chapter_idx].get("text", "")
        return text

    def _book_next_chunk(self):
        text = self._book_get_current_text()
        if not text:
            return ""
        # Return chunk from current pos, ~400 chars
        chunk = text[self._book_char_pos:self._book_char_pos + 400]
        return chunk.strip()

    def _book_advance(self, chars):
        text = self._book_get_current_text()
        self._book_char_pos = min(len(text), self._book_char_pos + chars)
        self._save_book_state()

    def _book_rewind_chapter(self):
        self._book_char_pos = 0
        self._save_book_state()

    def _book_next_chapter(self):
        if not self._books or self._book_idx >= len(self._books):
            return
        chs = self._books[self._book_idx]["chapters"]
        if self._book_chapter_idx + 1 < len(chs):
            self._book_chapter_idx += 1
            self._book_char_pos = 0
            self._save_book_state()

    def _book_prev_chapter(self):
        if self._book_chapter_idx > 0:
            self._book_chapter_idx -= 1
            self._book_char_pos = 0
            self._save_book_state()

    def _book_suggest(self):
        import random
        if not self._books or self._book_idx >= len(self._books):
            return ""
        chs = self._books[self._book_idx]["chapters"]
        if not chs:
