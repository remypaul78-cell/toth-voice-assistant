    def _ask_then_idle(self, question, extra_instruction=None):
        """Pose la question, puis vérifie s'il y a une question en attente."""
        self._ask_hermes(question, extra_instruction=extra_instruction)
        self._asking = False
        if hasattr(self, '_pending_question') and self._pending_question:
            q = self._pending_question
            self._pending_question = None
            print(f"[PENDING] Traitement: {q[:40]}")
            self._disp("> " + q, 18)
            self._asking = True
            threading.Thread(target=self._ask_then_idle, args=(q,), daemon=True).start()
