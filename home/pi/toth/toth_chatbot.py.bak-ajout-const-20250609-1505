    def _rgb(self, r, g, b):
        try: self.board.set_rgb(r, g, b)
        except Exception: pass

    def _disp(self, text, fs=22):
        """Display text on purple background, yellow text. Font size 22 default."""
        try:
            from PIL import Image, ImageDraw, ImageFont
            img = Image.new("RGB", (240, 280), "#2D004B")
            draw = ImageDraw.Draw(img)
            try:
                font = ImageFont.truetype(FONT_PATH, fs)
            except:
                font = ImageFont.load_default()
            words = text.split()
            lines = []; cur = ""
            for w in words:
                t = (cur + " " + w).strip()
                b = draw.textbbox((0, 0), t, font=font)
                if (b[2] - b[0]) > 224:
                    if cur: lines.append(cur)
                    cur = w
                else:
                    cur = t
            if cur: lines.append(cur)
            y = 8
            for line in lines[:12]:
                draw.text((8, y), line, font=font, fill="#FFFF00")
                y += fs + 2
            data = pil_to_rgb565(img)
            with self._display_lock:
                self.board.draw_image(0, 0, 240, 280, data)
        except Exception as e:
            print(f"[DISP] {e}")

    def _watch_override_file(self):
        """Watch /tmp/toth_display_override.txt — when modified, display its content for 8 seconds."""
        import time
        while True:
            try:
                if os.path.exists(self._override_file):
                    mtime = os.path.getmtime(self._override_file)
                    if mtime > self._override_mtime:
                        self._override_mtime = mtime
                        with open(self._override_file, "r") as f:
                            msg = f.read().strip()
                        if msg:
                            print(f"[OVERRIDE] Displaying: {msg[:60]}")
                            self._disp(msg, fs=22)
            except Exception as e:
                print(f"[OVERRIDE] Error: {e}")
            time.sleep(0.5)

    def _disp_scroll(self, full_text, batch_idx, total_batches, duration=None):
        """Smooth scroll: white bg, black text, font 22. Scrolls text upward during TTS playback."""
        import re
        if duration is None:
            duration = 5.0  # default if no MP3 duration available
        print(f"[DISP-SCROLL] batch={batch_idx}/{total_batches}, duration={duration:.1f}s, text_len={len(full_text)}")
        try:
            from PIL import Image, ImageDraw, ImageFont
            FONT_SIZE = 22
            font = ImageFont.truetype(FONT_PATH, FONT_SIZE)
            line_h = FONT_SIZE + 4
            screen_h = 280

            # Split into sentences (same logic as speak())
            sentences = re.split(r'(?<=[.!?»])\s+', full_text)
            merged = []
            for s in sentences:
                s = s.strip()
                if not s:
                    continue
                if merged and len(merged[-1]) < 8 and merged[-1][-1] not in '.!?»':
                    merged[-1] = merged[-1] + " " + s
                else:
                    merged.append(s)
            sentences = merged

            # Get current batch sentences (BATCH_SIZE=3, same as speak())
            BATCH_SIZE = 3
            start_s = batch_idx * BATCH_SIZE
            end_s = min(start_s + BATCH_SIZE, len(sentences))
            batch_sentences = sentences[start_s:end_s]
            batch_text = " ".join(batch_sentences)

            # Word-wrap
            words = batch_text.split()
            lines = []
            cur = ""
            for w in words:
                t = (cur + " " + w).strip() if cur else w
                b = font.getbbox(t)
                if (b[2] - b[0]) > 224:
                    if cur:
                        lines.append(cur)
                    cur = w
                else:
                    cur = t
            if cur:
                lines.append(cur)

            total_text_h = len(lines) * line_h + 16  # top+bottom padding

            # If text fits on screen, just show it static — no scroll needed
            if total_text_h <= screen_h:
                img = Image.new("RGB", (240, screen_h), "#2D004B")
                draw = ImageDraw.Draw(img)
                y = (screen_h - total_text_h) // 2 + 8
                for line in lines:
                    draw.text((8, y), line, font=font, fill="#FFFF00")
                    y += line_h
                with self._display_lock:
                    self.board.draw_image(0, 0, 240, screen_h, pil_to_rgb565(img))
                return

            # Scroll animation — smooth upward at ~50 px/sec
            scroll_speed = 100.0  # px/sec (2x accéléré)
            total_scroll = total_text_h - screen_h + 20
            anim_duration = min(duration, total_scroll / scroll_speed)
            fps = 12
            step = total_scroll / max(1, anim_duration * fps)
            frame_time = 1.0 / fps

            print(f"[SCROLL] lines={len(lines)}, total_h={total_text_h}, scroll={total_scroll:.0f}px, "
                  f"anim={anim_duration:.1f}s, fps={fps}, step={step:.1f}px")

            # Stop any previous scroll
            self._scroll_running = False
            time.sleep(0.05)

            self._scroll_running = True
            def animate():
                scroll_y = 0.0
                last_frame = None
                while self._scroll_running and scroll_y < total_scroll:
                    try:
                        img = Image.new("RGB", (240, screen_h), "#2D004B")
                        draw = ImageDraw.Draw(img)
                        y = 8 - scroll_y
                        for line in lines:
                            if -line_h < y < screen_h:
                                draw.text((8, y), line, font=font, fill="#FFFF00")
                            y += line_h

                        # Only push frame if different (SPI is slow on Pi Zero)
                        data = pil_to_rgb565(img)
                        if data != last_frame:
                            with self._display_lock:
                                self.board.draw_image(0, 0, 240, screen_h, data)
                            last_frame = data

                        scroll_y += step
                        time.sleep(frame_time)
                    except Exception as e:
                        print(f"[SCROLL] Frame error: {e}")
                        break
                # Final frame: show last lines
                try:
                    img = Image.new("RGB", (240, screen_h), "#2D004B")
                    draw = ImageDraw.Draw(img)
                    y = screen_h - (len(lines) * line_h) - 8
                    for line in lines:
                        draw.text((8, y), line, font=font, fill="#FFFF00")
                        y += line_h
                    with self._display_lock:
                        self.board.draw_image(0, 0, 240, screen_h, pil_to_rgb565(img))
                except Exception:
                    pass

            t = threading.Thread(target=animate, daemon=True)
            t.start()

        except Exception as e:
            print(f"[DISP-SCROLL] Error: {e} — fallback")
            try:
                self._disp(full_text[:200], 22)
            except Exception:
                pass

    def _stop_scroll(self):
        """Stop the smooth scroll animation thread."""
        self._scroll_running = False

    def _start_clock(self):
        """Start robot face loop in background thread."""
        if self._clock_running:
            return
        self._clock_running = True
        self._rgb(0, 0, 0)  # LED off during face display
        def loop():
            last_data = None  # Cache to avoid redrawing identical frames
            # Small initial delay — avoids flash during state transition
            for _ in range(10):
                if not self._clock_running:
                    return
                time.sleep(0.1)
            while self._clock_running:
                try:
                    data = None  # eyes disabled
                    # Only redraw if expression changed (Pi Zero SPI is slow)
                    if False and data != last_data:
                        with self._display_lock:
                            self.board.draw_image(0, 0, 240, 280, data)
                        last_data = data
                except Exception as e:
                    print(f"[FACE] Error: {e}")
                    break
                # 20-second refresh (200 × 0.1s) — Pi Zero SPI can't handle faster
                for _ in range(200):
                    if not self._clock_running:
                        return
                    time.sleep(0.1)
        self._clock_thread = threading.Thread(target=loop, daemon=True)
        self._clock_thread.start()
        self._batt_timer = threading.Timer(900, self._send_battery_telegram)
        self._batt_timer.daemon = True
        self._batt_timer.start()
        print("[FACE] Started")

    def _stop_clock(self):
        self._clock_running = False
        if self._batt_timer:
            self._batt_timer.cancel()
            self._batt_timer = None

    def _btn_press(self):
        """Button pressed — record time for long-press detection, show feedback."""
        print(f"[BTN] ⬇️  PRESS at {time.time():.1f}")
        self._press_start = time.time()
        self._btn_held = True  # Block live transcription from overwriting hold message
        with self.lock: s = self.state
        if s == STATE_IDLE:
            pass  # No message
        elif s == STATE_RECORD:
            threading.Thread(target=self._cancel_after_3s, daemon=True).start()

    def _btn_release(self):
        """Button released — short press = normal, 3-10s = soft reset, ≥10s = hard restart."""
        print(f"[BTN] ⬆️  RELEASE at {time.time():.1f}")
        if not hasattr(self, '_press_start'):
            return
        global _TTS_PROC
        held = time.time() - self._press_start
        del self._press_start
        self._btn_held = False  # Allow display updates again

        # If recording and held >= 3s = cancel recording
        if self.state == STATE_RECORD and held >= 3.0:
            print(f"[BTN] 3s HOLD — CANCELLING RECORDING")
            self._cancel_record_timeout()
            if self.rec:
                self.rec.stop()
                self.rec = None
            self._idle()
            return

        if held >= 10.0:
            # VERY LONG PRESS — hard restart via systemd (force-kill if stuck)
            print(f"[BTN] 🔨 HARD RESET ({held:.1f}s) — restarting toth.service")
            self._disp("🔨 REBOOT\nSERVICE...")
            self._cancel_flag = True
            if _TTS_PROC and _TTS_PROC.poll() is None:
                try:
                    os.killpg(os.getpgid(_TTS_PROC.pid), signal.SIGTERM)
                except Exception:
                    pass
            # Clean up state so next start is fresh
            self._pending_question = None
            try: os.remove("/tmp/toth_shared_session")
            except Exception: pass
            try: os.remove("/tmp/toth_waiting_since")
            except Exception: pass
            # Context brief preserved for Hermes bridge (7 June 2026 fix)
            pass
            sys.exit(0)
            return

        # SHORT PRESS — normal behavior (debounce + state machine)
        self._btn_short_press()

    def _btn_short_press(self):
        global _TTS_PROC
        # Debounce: ignore button presses during cooldown, except when recording (stop is always allowed)
        now = time.time()
        if hasattr(self, '_btn_dead_until') and now < self._btn_dead_until and self.state != STATE_RECORD:
            return
        print(f"[BTN] Press detected, state={self.state}")
        with self.lock: s = self.state
        # Block subsequent presses: 5s cooldown from idle (prevents runaway loops), 0.5s otherwise
        cooldown = 2.0 if s == STATE_IDLE else 0.5
        self._btn_dead_until = now + cooldown
        if s == STATE_IDLE:
            # Normal recording
            self._record()
        elif s == STATE_RECORD:
            self._process()
        else:
            # CANCEL ANYTHING — TTS, processing, waiting, everything
            print(f"[BTN] 🔴 CANCEL pressed during state={s} — killing everything")
            self._cancel_flag = True
            # Kill TTS process if running
            if _TTS_PROC and _TTS_PROC.poll() is None:
                try:
                    os.killpg(os.getpgid(_TTS_PROC.pid), signal.SIGTERM)
                    _TTS_PROC.wait(timeout=2)
                    print("[BTN] TTS killed")
                except Exception as e:
                    print(f"[BTN] Kill TTS error: {e}")
                    try:
                        _TTS_PROC.kill()
                    except Exception:
                        pass
                _TTS_PROC = None
            # Go back to idle
            self._idle()

    def _on_live_text(self, text):
        """Callback from AudioRecorder — display accumulated live transcription."""
        if self.state != STATE_RECORD:
            return  # guard: late chunks after user presses button
        if self._btn_held:
            return  # don't overwrite hold message while button is down
        self._disp(f"\U0001f3a4 {text}" if text else "\U0001f3a4 Parlez...")

    def _record(self):
        global RADIO_WAS_PLAYING
        print("[REC] Starting recording...")
        open("/tmp/toth_recording", "w").close()  # anti-larsen
        self._stop_clock()
        # Stop radio if playing, remember which one to resume later
        radio_was_on = os.path.exists(radio_mod.PID_FILE)
        if radio_was_on:
            state_file = "/tmp/toth_radio_state"
            if os.path.exists(state_file):
                with open(state_file) as f:
                    RADIO_WAS_PLAYING = f.read().strip()
                print(f"[REC] Radio {RADIO_WAS_PLAYING} playing — stopping for recording...")
            radio_mod.stop_radio()
            time.sleep(0.3)
        with self.lock: self.state = STATE_RECORD
        self._disp("\U0001f3a4 Parlez...")
        self.rec = AudioRecorder()
        self._record_timeout = threading.Timer(MAX_RECORD_SEC, self._record_timeout_cb)
        self._record_timeout.start()
        if not self.rec.start(self._on_live_text):
            self._cancel_record_timeout()
            try:
                os.remove("/tmp/toth_recording")
            except OSError:
                pass


    def _cancel_record_timeout(self):
        """Annule le timer d'annulation automatique."""
        if hasattr(self, '_record_timeout') and self._record_timeout:
            self._record_timeout.cancel()
            self._record_timeout = None

    def _record_timeout_cb(self):
        """Annulation automatique après MAX_RECORD_SEC sans validation."""
        print("[REC] Timeout — annulation automatique")
        self._btn_held = False
        try: os.remove("/tmp/toth_recording")
        except OSError: pass
        self._cancel_record_timeout()
        if self.rec:
            self.rec.stop()
            self.rec = None
        self._idle()  # retour au visage

    def _cancel_after_3s(self):
        """Wait 3s — cancel recording if still pressed. Runs in a thread."""
        start = time.time()
        while time.time() - start < 3.0:
            time.sleep(0.2)
            if not self._btn_held:
                return  # Released before 3s
        # 3s elapsed, still held — cancel
        print("[BTN] 3s HOLD — CANCELLING")
        try: os.remove("/tmp/toth_recording")
        except OSError: pass  # anti-larsen
        self._btn_held = False
        self._cancel_record_timeout()
        if self.rec:
            self.rec.stop()
            self.rec = None
        self._idle()

    def _process(self):
        print("[PROC] Stopping recording...")
        self._cancel_record_timeout()  # annule le timer, validation manuelle
        try: os.remove("/tmp/toth_recording")
        except OSError: pass  # anti-larsen
        self._btn_held = False  # Ensure display is unfrozen (in case timeout fired while holding)
        with self.lock: self.state = STATE_PROCESS
        pass  # Ne pas effacer la question
        q = ""
        if self.rec:
            q = self.rec.stop(); self.rec = None
        if not q:
            self._disp("Pas compris.\nRéessayez.")
            threading.Timer(5.0, lambda: self._show_menu(self._menu_idx)).start(); return
        self._disp("> " + q, 18)
        threading.Thread(target=self._ask_hermes, args=(q,), daemon=True).start()

