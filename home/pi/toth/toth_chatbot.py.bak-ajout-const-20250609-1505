                    draw.text((CX, 20), "VOLUME", font=font_big, fill="#00FFFF")
                    pct = self._volume_pct
                    draw.text((CX, 80), f"{pct}%", font=font_big, fill="#00FF00")
                    bar_w = 110
                    filled = int(bar_w * pct / 100)
                    draw.rectangle([CX, 130, CX + bar_w, 150], outline="#FFFFFF", width=1)
                    draw.rectangle([CX, 130, CX + filled, 150], fill="#00FF00")
                elif cur_tab == "BOOT":
                    draw.text((CX, 40), "BOOT?", font=font_big, fill="#FFFF00")
                    draw.text((CX, 130), "Milieu = OUI", font=font_med, fill="#00FF00")
                elif cur_tab == "OFF":
                    draw.text((CX, 40), "ETEINDRE?", font=font_big, fill="#FF3030")
                    draw.text((CX, 130), "Milieu = OUI", font=font_med, fill="#FF0000")
                data = pil_to_rgb565(img)
                with self._display_lock:
                    self.board.draw_image(0, 0, 240, 280, data)
            except Exception:
                self._disp("PARAMETRES", 24)
        else:
            self._disp(self._menu_items[idx], 24)

    def _ring_action(self, action):
        try:
            if action == "record":
                if self._menu_items[self._menu_idx] == "RADIO":
                    self._ring_radio_toggle()
                elif self._menu_items[self._menu_idx] == "PARAMETRES":
                    pass
                else:
                    self._btn_press()
                    self._btn_release()
            elif action in ("droite", "gauche"):
                if action == "droite":
                    self._menu_idx = (self._menu_idx + 1) % len(self._menu_items)
                else:
                    self._menu_idx = (self._menu_idx - 1) % len(self._menu_items)
                self._show_menu(self._menu_idx)
            elif action in ("haut", "bas"):
                if self._menu_items[self._menu_idx] == "RADIO":
                    total = len(self._ring_radio_stations())
                    if action == "haut":
                        self._radio_station_idx = (self._radio_station_idx + 1) % total
                    else:
                        self._radio_station_idx = (self._radio_station_idx - 1) % total
                    self._show_menu(self._menu_idx)
                elif self._menu_items[self._menu_idx] == "PARAMETRES":
                    tabs = self._param_tabs
                    cur_tab = tabs[self._param_submenu_idx % len(tabs)]
                    if action == "haut":
                        self._param_submenu_idx = (self._param_submenu_idx + 1) % len(tabs)
                        self._show_menu(self._menu_idx)
                    elif action == "bas":
                        self._param_submenu_idx = (self._param_submenu_idx - 1) % len(tabs)
                        self._show_menu(self._menu_idx)
                    elif action == "record":
                        if cur_tab in ("SON", "CONSTANTES"):
                            pass
                        elif cur_tab == "BOOT":
                            try:
                                subprocess.Popen(["sudo", "reboot"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                                print("[PARAM] Executing reboot")
                            except Exception as e:
                                print(f"[PARAM] reboot error: {e}")
                        elif cur_tab == "OFF":
                            try:
                                subprocess.Popen(["sudo", "poweroff"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                                print("[PARAM] Executing poweroff")
                            except Exception as e:
                                print(f"[PARAM] poweroff error: {e}")
        except Exception as e:
            print(f"[RING] Action error: {e}")

    def _ring_radio_stations(self):
        """Return ordered list of station URLs (same stations as radio.py)."""
        import radio as radio_mod
        return list(radio_mod.RADIOS.values())  # [(name, url), ...]

    def _ring_radio_play(self):
        """Start mpg123 on the current station."""
        with self._radio_fade_lock:
            stations = self._ring_radio_stations()
            if not stations:
                return
            idx = self._radio_station_idx % len(stations)
            name, url = stations[idx]
            print(f"[RADIO] ▶ {name}")
            try:
                if self._radio_proc:
                    self._radio_proc.kill()
                    self._radio_proc = None
                self._radio_proc = subprocess.Popen(
                    ["ffmpeg", "-i", url, "-ar", "48000", "-ac", "2", "-f", "alsa", "hw:0,0", "-nostdin", "-loglevel", "error"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
                self._radio_playing = True
            except Exception as e:
                print(f"[RADIO] Play error: {e}")

    def _ring_radio_stop(self):
        """Stop radio playback."""
        with self._radio_fade_lock:
            if self._radio_proc:
                self._radio_proc.kill()
                self._radio_proc = None
            self._radio_playing = False

    def _ring_radio_toggle(self):
        """Toggle radio on/off."""
        if self._radio_playing:
            self._ring_radio_stop()
        else:
            self._ring_radio_play()

    def _ring_radio_next(self):
        """Switch to next station."""
        self._radio_station_idx = (self._radio_station_idx + 1) % len(self._ring_radio_stations())
        if self._radio_playing:
            self._ring_radio_play()
        else:
            name, _ = self._ring_radio_stations()[self._radio_station_idx]
            print(f"[RADIO] Selected: {name} (radio off)")

    def _ring_radio_prev(self):
        """Switch to previous station."""
        total = len(self._ring_radio_stations())
        self._radio_station_idx = (self._radio_station_idx - 1) % total
        if self._radio_playing:
            self._ring_radio_play()
        else:
            name, _ = self._ring_radio_stations()[self._radio_station_idx]
            print(f"[RADIO] Selected: {name} (radio off)")

    def _ring_radio_volume(self, direction):
        """Adjust radio volume via amixer Speaker. direction='up' or 'down'."""
        step = 5   # 5 = ~4% of 127
        new = self._radio_volume + step if direction == "up" else self._radio_volume - step
        new = max(0, min(127, new))
        if new != self._radio_volume:
            self._radio_volume = new
            try:
                subprocess.run(
                    ["amixer", "-c", "0", "set", "Speaker", str(new)],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
                pct = (new * 100) // 127
                print(f"[RADIO] 🔈 Volume {pct}%")
            except Exception as e:
                print(f"[RADIO] Volume error: {e}")

    def run(self):
        print("[TOTH] Started (Hermes direct mode).")
        # Règle 2 (auto-réparation) : heartbeat toutes les 5s
        heartbeat_path = "/tmp/toth_heartbeat"
        try:
            while True:
                try:
                    with open(heartbeat_path, "w") as f:
                        f.write(str(time.time()))
                except Exception:
                    pass
                time.sleep(POLL_INT)
        except KeyboardInterrupt:
            print("[TOTH] Shutdown.")
        finally:
            try: os.remove(heartbeat_path)
            except Exception: pass
            self._down()

    def _down(self):
        self._rgb(0, 0, 0)
        if self.rec:
            try: self.rec.stop()
            except Exception: pass
        if self.board:
            try: self.board.cleanup()
            except Exception: pass

