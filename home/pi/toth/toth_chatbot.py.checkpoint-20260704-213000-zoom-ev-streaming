    def _yt_load_files(self):
        """Scan the active subtab dir (video or audio) and populate self._yt_files."""
        d = self._yt_audio_dir if self._yt_subtab == 1 else self._yt_video_dir
        try:
            if self._yt_subtab == 1:
                exts = (".mp3", ".m4a", ".ogg", ".wav", ".flac", ".opus")
            else:
                exts = (".mp4", ".mkv", ".webm", ".avi", ".mov", ".m4v", ".3gp")
            items = []
            if os.path.isdir(d):
                for fn in os.listdir(d):
                    if fn.lower().endswith(exts) and not fn.startswith("."):
                        fp = os.path.join(d, fn)
                        try:
                            sz = os.path.getsize(fp)
                        except OSError:
                            sz = 0
                        items.append({"name": fn, "path": fp, "size": sz, "ext": os.path.splitext(fn)[1].lower()})
            items.sort(key=lambda x: x["name"].lower())
            self._yt_files = items
        except Exception as e:
            print(f"[YT] load_files error: {e}")
            self._yt_files = []
        if self._yt_file_idx >= len(self._yt_files):
            self._yt_file_idx = 0
        if self._yt_files and self._yt_file_idx < 0:
            self._yt_file_idx = 0

    def _yt_save_state(self):
        try:
            cur_name = ""
            if self._yt_files and 0 <= self._yt_file_idx < len(self._yt_files):
                cur_name = self._yt_files[self._yt_file_idx]["name"]
            st = {
                "subtab": self._yt_subtab,
                "file_idx": self._yt_file_idx,
                "file_name": cur_name,
                "pos_seconds": int(self._yt_pos_seconds),
                "duration": int(self._yt_duration),
            }
