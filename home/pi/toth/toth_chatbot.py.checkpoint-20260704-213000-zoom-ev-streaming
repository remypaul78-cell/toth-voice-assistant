def _get_recent_context(session_id, max_messages=5):
    """Read the last N user+assistant messages from the Hermes session DB
    and return them as a compact context string (or empty string if none)."""
    try:
        import sqlite3
        db = sqlite3.connect(os.path.expanduser("~/.hermes/state.db"))
        rows = db.execute('''
            SELECT role, content FROM messages
            WHERE session_id=? AND role IN ('user','assistant')
            ORDER BY id DESC LIMIT ?
        ''', (session_id, max_messages)).fetchall()
        db.close()
        if not rows:
            return ""
        lines = []
        for role, content in reversed(rows):
            if not content:
                continue
            # Keep it compact: strip long messages to ~300 chars
            short = content.strip()[:300]
            label = "Rémy" if role == "user" else "Hermes"
            lines.append(f"{label}: {short}")
        return "\n".join(lines)
    except Exception as e:
        print(f"[CTX] Failed to read session DB: {e}")
        return ""

def hermes_ask(question, timeout=300, extra_instruction=None):
    """Send question to Hermes via the LOCAL HTTP API (fast, no CLI startup).
    
    Reads /tmp/toth_shared_session for the active Telegram session ID,
    pulls the 5 most recent user+assistant messages from the session DB,
    and injects them into a lightweight one-shot prompt sent to the
    Hermes API server already running on http://49.13.237.85:8080.
    
    MUCH faster than hermes chat -q (no Python + openai import overhead).
    
    Returns (answer, sid) tuple on success, (None, None) on failure."""
    import json as _json
    try:
        # Read Telegram session ID
        session_id = None
        try:
            with open("/tmp/toth_shared_session", "r") as f:
                session_id = f.read().strip()
        except Exception:
            pass
        
        # Build prompt with recent context
        context = ""
        if session_id:
            context = _get_recent_context(session_id)
        
        # Read Hermes sync brief (pushed by Hermes after each decision)
        sync_brief = ""
        try:
            with open("/tmp/toth_context_brief", "r") as f:
                sync_brief = f.read().strip()
        except Exception:
            pass
        
        # Read Toth's persistent memory (identity, capabilities, state)
        toth_memory = ""
        try:
            with open("/home/pi/toth/memory.md", "r") as f:
                toth_memory = f.read().strip()
        except Exception:
            pass
        
        if context:
            brief_block = f"\n\n⚠️ Contexte ACTUEL (donné par Hermes, prioritaire sur l'historique) :\n{sync_brief}" if sync_brief else ""
            memory_block = f"\n\n📋 MA MÉMOIRE PERMANENTE (mon identité, mes capacités, mon état) :\n{toth_memory}" if toth_memory else ""
            extra_block = f"\n\n🎵 INSTRUCTION SPÉCIALE :\n{extra_instruction}" if extra_instruction else ""
            full_prompt = (
                "Contexte récent de la conversation Telegram:\n"
                f"{context}"
                f"{brief_block}"
                f"{memory_block}"
                f"{extra_block}\n\n"
                f"Rémy te parle via Toth (assistant vocal). Réponds en français, "
                f"de façon naturelle et concise (2-4 phrases max).\n\n"
                f"🏴‍☠️ Rémy 🏴‍☠️: {question}"
            )
        else:
            brief_block = f"\n\n⚠️ Contexte ACTUEL (donné par Hermes, prioritaire) :\n{sync_brief}\n" if sync_brief else ""
            memory_block = f"\n\n📋 MA MÉMOIRE PERMANENTE (mon identité, mes capacités, mon état) :\n{toth_memory}" if toth_memory else ""
            extra_block = f"\n\n🎵 INSTRUCTION SPÉCIALE :\n{extra_instruction}\n" if extra_instruction else ""
            full_prompt = (
                f"{brief_block}"
                f"{memory_block}"
                f"{extra_block}"
                f"Rémy te parle via Toth (assistant vocal). Réponds en français, "
                f"de façon naturelle et concise (2-4 phrases max).\n\n"
                f"🏴‍☠️ Rémy 🏴‍☠️: {question}"
            )
        
        # Use the LOCAL Hermes API (already running, no startup cost)
        api_url = "http://49.13.237.85:8080/v1/chat/completions"
        payload = _json.dumps({
            "model": "hermes",
            "messages": [{"role": "user", "content": full_prompt}],
            "max_tokens": 500,
            "temperature": 0.7,
            "session_id": "toth-direct"
        }).encode("utf-8")
        
        req = urllib.request.Request(
            api_url,
            data=payload,
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {HERMES_KEY}",
            },
            method="POST",
        )
        
        print(f"[API] POST {api_url} (5-msg context, session={session_id or 'NONE'}, timeout={timeout}s)...")
        t0 = time.time()
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read().decode("utf-8")
        dt = time.time() - t0
        
        data = _json.loads(body)
        answer = data.get("choices", [{}])[0].get("message", {}).get("content", "")
        print(f"[API] Got response in {dt:.1f}s ({len(answer)} chars)")
        
        if answer.strip():
            return (answer.strip(), None)
        else:
            print(f"[API] Empty response: {body[:300]}")
    except Exception as e:
        print(f"[API] Failed: {e}")
    return (None, None)

