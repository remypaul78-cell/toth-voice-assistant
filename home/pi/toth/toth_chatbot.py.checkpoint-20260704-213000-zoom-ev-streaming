    def _const_update_loop(self):
        while True:
            try:
                mem = os.popen("free -m | grep Mem:").read().strip().split()
                self._const_ram_total = mem[1]
                self._const_ram_used = mem[3]
            except: pass
            try:
                temp_raw = open("/sys/class/thermal/thermal_zone0/temp").read().strip()
                self._const_temp = str(int(temp_raw) / 1000) + " C"
            except: pass
            try:
                swap = os.popen("free -m | grep Swap:").read().strip().split()
                self._const_swap_total = swap[1]
                self._const_swap_used = swap[3]
            except: pass
            try:
                self._const_load = os.popen("uptime").read().strip().split("load average: ")[-1]
            except: pass
            try:
                disk_out = subprocess.check_output(["df", "-h", "/"]).decode().strip().splitlines()
                parts = disk_out[1].split()
                self._const_disk_used = parts[2]
                self._const_disk_pct = parts[4]
            except: pass
            time.sleep(10)

    def _bt_scan(self):
        """Scan Bluetooth et met à jour _bt_devices."""
        import subprocess
        self._bt_scanning = True
        self._show_menu(self._menu_idx)
        try:
            # Vider liste precedente
            self._bt_devices = []
            # Scan de 3 minutes avec hcitool
            result = subprocess.run(
                ["hcitool", "scan", "--flush"],
                capture_output=True, text=True, timeout=15
            )
            for line in result.stdout.strip().split('\n'):
                parts = line.strip().split()
                if len(parts) >= 2 and ':' in parts[0]:
                    mac = parts[0]
                    name = ' '.join(parts[1:]) if len(parts) > 1 else '?'
                    # Verifier si paired/connected via bluetoothctl
                    paired = False
                    connected = False
                    try:
                        info = subprocess.run(
                            ["bluetoothctl", "info", mac],
                            capture_output=True, text=True, timeout=3
                        ).stdout
                        paired = "Paired: yes" in info
                        connected = "Connected: yes" in info
                    except: pass
                    self._bt_devices.append({
                        "mac": mac, "name": name,
                        "paired": paired, "connected": connected
                    })
        except Exception as e:
            print(f"[BT] scan error: {e}")
        finally:
            self._bt_scanning = False
            self._bt_last_scan = time.time()
            self._show_menu(self._menu_idx)

    def _bt_pair(self, mac):
        """Appairer un peripherique avec PIN auto=0000."""
        import subprocess, select, time
        try:
            subprocess.run(["bluetoothctl", "pairable", "on"], timeout=3)
            subprocess.run(["bluetoothctl", "agent", "on"], timeout=3)
            subprocess.run(["bluetoothctl", "default-agent"], timeout=3)
            # Lancer pair en mode interactif pour capter le PIN
            proc = subprocess.Popen(
                ["bluetoothctl"],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True, bufsize=1
            )
            def _send(cmd):
                proc.stdin.write(cmd + "\n")
                proc.stdin.flush()
            _send(f"pair {mac}")
            paired = False
            start = time.time()
            while time.time() - start < 20:
                ready, _, _ = select.select([proc.stdout], [], [], 1.0)
                if ready:
                    line = proc.stdout.readline()
                    print(f"[BT] {line.strip()}")
                    if "Passkey" in line or "PIN code" in line or "passkey" in line.lower():
                        _send("0000")
                        print("[BT] Sent PIN 0000")
                    elif "Pairing successful" in line:
                        paired = True
                        break
                    elif "Failed" in line or "ConnectionFailed" in line or "refused" in line.lower():
                        break
            _send("quit")
            proc.wait(timeout=5)
            if paired:
                print(f"[BT] Paired {mac}")
            return paired
        except Exception as e:
            print(f"[BT] pair error: {e}")
            return False

    def _bt_connect(self, mac):
        """Connecter un peripherique paire."""
        import subprocess
        try:
            out = subprocess.run(
                ["bluetoothctl", "connect", mac],
                capture_output=True, text=True, timeout=10
            )
            if "Connection successful" in out.stdout or "Already connected" in out.stdout:
                print("[BT] Connected " + mac)
                # Switcher le son sur BT
                try:
                    bt_sink = subprocess.run(["pactl", "list", "sinks", "short"], capture_output=True, text=True, timeout=5).stdout
                    for line in bt_sink.split(chr(10)):
                        if "bluez" in line:
                            sink_name = line.split()[1]
                            subprocess.run(["pactl", "set-default-sink", sink_name], timeout=5)
                            print("[BT] Audio sur " + sink_name)
                            break
                except Exception as e:
                    print("[BT] Sink error: " + str(e))
                return True
            else:
                print("[BT] Connect response: " + out.stdout)
                return False
        except Exception as e:
            print("[BT] connect error: " + str(e))
            return False

    def _bt_disconnect(self, mac):
        """Deconnecter un peripherique."""
        import subprocess
        try:
            subprocess.run(["bluetoothctl", "disconnect", mac], timeout=5)
            print(f"[BT] Disconnected {mac}")
            return True
        except Exception as e:
            print(f"[BT] disconnect error: {e}")
            return False

    def _bt_remove(self, mac):
        """Supprimer un peripherique appaire."""
        import subprocess
        try:
            subprocess.run(["bluetoothctl", "remove", mac], timeout=5)
            print(f"[BT] Removed {mac}")
            return True
        except Exception as e:
            print(f"[BT] remove error: {e}")
            return False

    def _missive_handle_record(self):
        """Gerer bouton milieu dans MISSIVE."""
        if self._missive_state == "idle":
            # Demarrer enregistrement
            self._missive_state = "recording"
            self._missive_preview = ""
            self._show_menu(self._menu_idx)
            threading.Thread(target=self._missive_record_task, daemon=True).start()
        elif self._missive_state == "recording":
            # Stop recording, passer en preview
            self._missive_state = "preview"
            self._show_menu(self._menu_idx)
        elif self._missive_state == "preview":
            text = self._missive_preview.strip()
            if text:
                self._missive_state = "confirm"
                self._show_menu(self._menu_idx)
            else:
                self._missive_state = "idle"
                self._missive_preview = ""
                self._show_menu(self._menu_idx)
        elif self._missive_state == "confirm":
            text = self._missive_preview.strip()
            if text:
                self._missive_history.append({"role": "user", "text": text})
                self._missive_state = "sending"
                self._show_menu(self._menu_idx)
                threading.Thread(target=self._missive_send_to_hermes, args=(text,), daemon=True).start()
            else:
                self._missive_state = "idle"
                self._missive_preview = ""
                self._show_menu(self._menu_idx)

    def _missive_record_task(self):
        """Enregistre audio et transcrit quand stop demande."""
        import subprocess, tempfile, os, requests
        try:
            fd, path = tempfile.mkstemp(suffix=".wav")
            os.close(fd)
            # Enregistrement continu jusqu'a _missive_state != "recording"
            proc = subprocess.Popen(
                ["arecord", "-D", "plughw:1,0", "-f", "S16_LE", "-r", "16000", "-c", "1", path],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            while proc.poll() is None and self._missive_state == "recording":
                time.sleep(0.2)
            proc.terminate()
            try:
                proc.wait(timeout=2)
            except:
                proc.kill()
            # Si on est en preview, transcrire
            if self._missive_state == "preview" and os.path.getsize(path) > 1000:
                # Transcription via Whisper (Groq)
                try:
                    with open(path, "rb") as af:
                        resp = requests.post(
                            "https://api.groq.com/openai/v1/audio/transcriptions",
                            headers={"Authorization": "Bearer " + os.environ.get("GROQ_KEY", "")},
                            files={"file": ("audio.wav", af, "audio/wav")},
                            data={"model": "whisper-large-v3", "language": "fr", "response_format": "json", "prompt": _WHISPER_PROMPT, "temperature": "0.0"},
                            timeout=10)
                    if resp.status_code == 200:
                        self._missive_preview = resp.json().get("text", "?")
                    else:
                        self._missive_preview = f"Err {resp.status_code}"
                except Exception as e:
                    self._missive_preview = f"Err: {e}"
                self._show_menu(self._menu_idx)
        finally:
            try:
                os.unlink(path)
            except: pass

    def _missive_send_to_hermes(self, text):
        """Envoie message a Hermes, recupere reponse TTS locale."""
        import requests
        try:
            payload = {"message": text, "session_id": self._session_id if hasattr(self, '_session_id') else "toth"}
            resp = requests.post(
                "https://toth-bridge.example/chat",  # Placeholder — adapte selon ton endpoint
                json=payload, timeout=30)
            reply = resp.json().get("reply", "...")
            self._missive_history.append({"role": "v4", "text": reply})
            # Reponse TTS locale via edge-tts
            threading.Thread(target=self._missive_tts, args=(reply,), daemon=True).start()
        except Exception as e:
            self._missive_history.append({"role": "v4", "text": f"Erreur: {e}"})
        finally:
            self._missive_state = "idle"
            self._missive_preview = ""
            self._show_menu(self._menu_idx)

    def _missive_tts(self, text):
        """Joue reponse TTS localement."""
        import subprocess, tempfile, os
        try:
            fd, mp3 = tempfile.mkstemp(suffix=".mp3")
            os.close(fd)
            # Generer TTS avec edge-tts
            subprocess.run(
                ["edge-tts", "--text", text[:200], "--write-media", mp3],
                timeout=15)
            if os.path.exists(mp3) and os.path.getsize(mp3) > 100:
                subprocess.run(["ffplay", "-nodisp", "-autoexit", mp3], timeout=60)
        except Exception as e:
            print(f"[MISSIVE] TTS error: {e}")
        finally:
            try: os.unlink(mp3)
            except: pass

    def _bt_handle_record(self):
        """Gerer bouton milieu dans BT — entrée puis options."""
        if not self._bt_inside:
            # Premier tap sur onglet BT : entrer dans les options
            self._bt_inside = True
            self._bt_idx = 0
            self._show_menu(self._menu_idx)
            return
        if self._bt_submenu:
            devs = self._bt_devices
            if not devs:
                self._disp("Aucun appareil")
                return
            cur = devs[self._bt_selected_idx % len(devs)]
            mac = cur["mac"]
            if cur.get("connected"):
                self._bt_disconnect(mac)
            elif cur.get("paired"):
                self._bt_connect(mac)
            else:
                self._disp("PAIRING...\n" + cur.get("name","?")[:15])
                ok = self._bt_pair(mac)
                if ok:
                    self._disp("PAIRED\nCONNECTING...")
                    time.sleep(0.5)
                    self._bt_connect(mac)
                else:
                    self._disp("REFUSED\n" + cur.get("name","?")[:15])
                    threading.Timer(2.0, lambda: self._show_menu(self._menu_idx)).start()
            return
        # _bt_inside = True, pas _bt_submenu → exécuter option sélectionnée
        opt = ["APPAREILS", "SCANNER", "BT ON", "BT OFF"][self._bt_idx % 4]
        if opt == "APPAREILS":
