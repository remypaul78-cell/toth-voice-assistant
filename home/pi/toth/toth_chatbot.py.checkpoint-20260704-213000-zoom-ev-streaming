    def _camera_start_video(self):
        """Démarre rpicam-vid + streaming preview sur l'ecran."""
        import subprocess, os, threading, time
        import time as _time, shutil
        tmp_video = "/tmp/toth_camera_video.h264"
        os.makedirs("/home/pi/toth/camera/videos", exist_ok=True)
        ts = _time.strftime("%Y%m%d_%H%M%S")
        video_path = f"/home/pi/toth/camera/videos/{ts}.h264"
        # Move temp video to permanent location
        if os.path.exists(tmp_video) and os.path.getsize(tmp_video) > 1000:
            try:
                shutil.move(tmp_video, video_path)
            except Exception:
                video_path = tmp_video
        try:
            self._camera_stop_video()
            time.sleep(0.3)
            self._camera_recording = True
            self._show_menu(self._menu_idx)

            cmd = [
                "rpicam-vid", "-o", video_path,
                "--width", "640", "--height", "480",
                "--framerate", "15", "--codec", "h264",
                "--timeout", "0",
                "--autofocus-on-capture", "1",
                "--awb", "daylight", "--ev", "-1.0",
                "--denoise", "off", "--inline-headers"
