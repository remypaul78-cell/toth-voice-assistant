    def _camera_start_stream(self):
        """Streaming live: rpicam-vid YUV420 fichier, conversion numpy RGB565, lecture derniere frame."""
        import subprocess, os, threading, time
        import numpy as np
        try:
            # Kill any leftover rpicam-vid from previous run
            if getattr(self, '_camera_stream_proc', None):
                try:
                    self._camera_stream_proc.kill()
                    self._camera_stream_proc.wait(timeout=2)
                except:
                    pass
                self._camera_stream_proc = None
            # Also kill any orphaned rpicam-vid processes
            try:
                subprocess.run(["pkill", "-9", "-f", "rpicam-vid.*toth_stream"], capture_output=True, timeout=3)
                time.sleep(0.5)
            except:
                pass
            self._camera_streaming = True
            self._show_menu(self._menu_idx)
            self._camera_stream_running = True
            W, H = 240, 280
            STRIDE = 256
            frame_size = STRIDE * H * 3 // 2
            stream_file = "/tmp/toth_stream.yuv"
            try:
                os.remove(stream_file)
            except:
                pass
            cmd = [
                "rpicam-vid", "--codec", "yuv420",
                "--width", str(W), "--height", str(H),
                "--framerate", "15",
                "--timeout", "0",
                "--output", stream_file,
                "--flush",
                "--ev", "-1.0",
                "--awb", "daylight",
                "--denoise", "off"
            ]
            def stream_loop():
                try:
                    proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    self._camera_stream_proc = proc
                    print("[CAMERA] Stream demarre (numpy+file)")
                    time.sleep(1.5)  # wait for rpicam-vid to start writing
                    frame_count = 0
                    last_displayed = 0
                    while self._camera_stream_running:
                        if proc.poll() is not None:
                            # rpicam-vid s'est arrêté (tué par snap_and_stream ou crash)
                            # Le relancer automatiquement !
                            print("[CAMERA] rpicam-vid tué, relance automatique...")
                            try:
                                os.remove(stream_file)
                            except:
                                pass
                            time.sleep(0.5)
                            proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                            self._camera_stream_proc = proc
                            time.sleep(1.5)
                            last_displayed = 0
                            print("[CAMERA] Stream relancé")
                            continue
                        try:
                            fsize = os.path.getsize(stream_file)
                        except:
                            fsize = 0
                        if fsize >= frame_size:
                            # Seek to LAST complete frame
                            last_frame = (fsize // frame_size - 1) * frame_size
                            # Skip if we already displayed this exact frame
                            if last_frame == last_displayed:
                                time.sleep(0.03)
                                continue
                            try:
                                with open(stream_file, "rb") as f:
                                    f.seek(last_frame)
                                    raw = f.read(frame_size)
                            except Exception as e:
                                time.sleep(0.05)
                                continue
                            if len(raw) == frame_size:
                                # Y plane: stride x h, crop to w x h
                                y = np.frombuffer(raw[:STRIDE*H], dtype=np.uint8).reshape(H, STRIDE)[:, :W]
                                uv_offset = STRIDE * H
                                u = np.frombuffer(raw[uv_offset:uv_offset+(STRIDE//2)*(H//2)], dtype=np.uint8).reshape(H//2, STRIDE//2)[:, :W//2]
                                v = np.frombuffer(raw[uv_offset+(STRIDE//2)*(H//2):], dtype=np.uint8).reshape(H//2, STRIDE//2)[:, :W//2]
                                # Upsample U,V
                                u_full = np.repeat(np.repeat(u, 2, axis=0), 2, axis=1)
                                v_full = np.repeat(np.repeat(v, 2, axis=0), 2, axis=1)
                                # YCbCr -> RGB (BT.601) using integer math for speed
                                yf = y.astype(np.int16)
                                u_i = u_full.astype(np.int16) - 128
                                v_i = v_full.astype(np.int16) - 128
                                r = np.clip(yf + (v_i * 359 >> 8), 0, 255).astype(np.uint8)
                                g = np.clip(yf - (u_i * 88 >> 8) - (v_i * 183 >> 8), 0, 255).astype(np.uint8)
                                b = np.clip(yf + (u_i * 454 >> 8), 0, 255).astype(np.uint8)
                                # RGB565 big-endian
                                r5 = (r >> 3).astype(np.uint16)
                                g6 = (g >> 2).astype(np.uint16)
                                b5 = (b >> 3).astype(np.uint16)
                                rgb565 = (r5 << 11) | (g6 << 5) | b5
                                buf = rgb565.byteswap().tobytes()
                                try:
                                    with self._display_lock:
                                        self.board.draw_image(0, 0, W, H, buf)
                                    frame_count += 1
                                    last_displayed = last_frame
                                except Exception as e:
                                    print(f"[CAMERA] Draw error: {e}")
                        time.sleep(0.03)  # ~33fps max, minimal delay
                    try:
                        proc.kill()
                        proc.wait(timeout=3)
                    except:
                        pass
                    self._camera_stream_proc = None
                    self._camera_stream_running = False
                    try:
                        os.remove(stream_file)
                    except:
                        pass
                    print(f"[CAMERA] Stream termine ({frame_count} frames affichees)")
                except Exception as e:
                    print(f"[CAMERA] Stream error: {e}")
                    try:
                        proc.kill()
                    except:
                        pass
                    self._camera_stream_proc = None
                    self._camera_stream_running = False
                    self._camera_streaming = False
            t = threading.Thread(target=stream_loop, daemon=True)
            t.start()
        except Exception as e:
            print(f"[CAMERA] Erreur stream: {e}")
            self._camera_streaming = False
            self._show_menu(self._menu_idx)

