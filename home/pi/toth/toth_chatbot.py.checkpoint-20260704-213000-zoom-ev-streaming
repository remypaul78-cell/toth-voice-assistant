            if os.path.exists(self._yt_state_file):
                with open(self._yt_state_file, "r") as f:
                    st = json.load(f)
                self._yt_subtab = int(st.get("subtab", 0)) % 2
                self._yt_file_idx = int(st.get("file_idx", 0))
                self._yt_pos_seconds = int(st.get("pos_seconds", 0))
                self._yt_duration = int(st.get("duration", 0))
                # Try to restore file_idx by name
                fname = st.get("file_name", "")
                self._yt_load_files()
                if fname:
                    for i, fobj in enumerate(self._yt_files):
                        if fobj["name"] == fname:
                            self._yt_file_idx = i
                            break
        except Exception as e:
            print(f"[YT] load_state error: {e}")

    def _yt_probe_duration(self, file_path):
        """Best-effort: try ffprobe to get duration in seconds. Returns 0 on failure."""
        try:
            r = subprocess.run(
                ["ffprobe", "-v", "error", "-show_entries", "format=duration",
                 "-of", "default=noprint_wrappers=1:nokey=1", file_path],
                capture_output=True, text=True, timeout=8
            )
            txt = (r.stdout or "").strip()
            if txt:
                return int(float(txt))
        except Exception:
            pass
        return 0

    def _yt_play(self, file_path, start_seconds=0):
        self._stop_all_media(except_tab="YT")
        """Launch ffplay (video) or mpg123 (audio). start_seconds is the resume offset."""
        self._yt_stop(silent=True)
        self._yt_pos_seconds = max(0, int(start_seconds))
        sub = self._yt_subtab
        ext = os.path.splitext(file_path)[1].lower()
        is_video = (sub == 0) or ext in (".mp4", ".mkv", ".webm", ".avi", ".mov", ".m4v", ".3gp")
        env = os.environ.copy()
        env["DISPLAY"] = ""  # ensure no X11
        try:
            if is_video:
                # Vidéo: ffplay avec seek
                if start_seconds > 0:
                    cmd = ["ffplay", "-autoexit", "-fs", "-loglevel", "quiet",
                           "-ss", str(int(start_seconds)), "-i", file_path]
                else:
                    cmd = ["ffplay", "-autoexit", "-fs", "-loglevel", "quiet", "-i", file_path]
                env2 = env.copy()
                env2["SDL_VIDEODRIVER"] = env2.get("SDL_VIDEODRIVER", "directfb")
                env2["SDL_FBDEV"] = env2.get("SDL_FBDEV", "/dev/fb0")
                self._yt_proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                                                 stderr=subprocess.DEVNULL, env=env2)
            else:
                # Audio: mpg123 direct ALSA plughw:0,0 (PulseAudio down)
                cmd = ["mpg123", "-q", "-o", "alsa", "-a", "plughw:0,0", file_path]
                self._yt_proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                                                 stderr=subprocess.DEVNULL, env=env)
            self._yt_is_playing = True
            # Probe duration in background
            def _probe():
                d = self._yt_probe_duration(file_path)
                if d:
                    self._yt_duration = d
            threading.Thread(target=_probe, daemon=True).start()
            # Position-saver + screen-refresh thread: every 1s while playing
            def _pos_loop():
                last = time.time()
                # Boucle tant que proc mpg123/ffplay est vivant (pas gated par _yt_is_playing)
                while self._yt_proc is not None and self._yt_proc.poll() is None:
                    time.sleep(1.0)
                    self._yt_pos_seconds += 1
                    now = time.time()
                    if now - last >= 5.0:
                        self._yt_save_state()
                        last = now
                    # Rafraîchir l'écran (try_lock non-bloquant)
                    try:
                        if self._display_lock.acquire(blocking=False):
                            try:
                                cur_tab = self._media_tabs[self._media_idx % len(self._media_tabs)]
                                if (self._menu_items[self._menu_idx] == "MEDIA"
                                        and getattr(self, "_media_inside", False)
                                        and cur_tab == "YT"):
                                    self._show_menu(self._menu_idx)
                            finally:
                                self._display_lock.release()
                    except Exception:
                        pass
                # Proc mort: save final
                self._yt_is_playing = False
                self._yt_save_state()
            self._yt_seek_thread = threading.Thread(target=_pos_loop, daemon=True)
            self._yt_seek_thread.start()
        except Exception as e:
            print(f"[YT] play error: {e}")
            self._yt_is_playing = False
            self._yt_proc = None

    def _yt_stop(self, silent=False):
        was_playing = self._yt_is_playing
        self._yt_is_playing = False
        try:
            if self._yt_proc is not None and self._yt_proc.poll() is None:
                self._yt_proc.terminate()
                try:
                    self._yt_proc.wait(timeout=2)
                except Exception:
                    try:
                        self._yt_proc.kill()
                    except Exception:
                        pass
        except Exception as e:
            if not silent:
                print(f"[YT] stop error: {e}")
        self._yt_proc = None
        if was_playing:
            self._yt_save_state()

