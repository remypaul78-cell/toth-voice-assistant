    def _ring_action(self, action):
        # Annuler le timer des yeux (activité bague détectée)
        if hasattr(self, '_idle_eyes_timer'):
            self._idle_eyes_timer.cancel()
        if getattr(self, '_photo_on_screen', False):
            print("[PHOTO] Bague pressée, reprise idle")
            self._photo_on_screen = False
            if hasattr(self, '_idle_eyes_timer'):
                self._idle_eyes_timer.cancel()
            self._idle_eyes_timer = threading.Timer(600.0, self._start_clock)
