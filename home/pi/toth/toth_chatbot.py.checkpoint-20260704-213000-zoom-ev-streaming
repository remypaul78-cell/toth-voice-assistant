    def _book_get_smart_chunk(self):
        """Get a chunk from current pos, cut at sentence boundary (~300-500 chars)."""
        text = self._book_get_current_text()
        if not text:
            return ""
        pos = self._book_char_pos
        remaining = text[pos:]
        if not remaining:
            return ""
        # Take up to 500 chars, then extend to end of sentence
        chunk = remaining[:500]
        # Find last sentence end (. ! ? » followed by space or end)
        import re
        matches = list(re.finditer(r'[.!?]\s+', chunk))
        if matches:
            cut = matches[-1].end()
        else:
            # No sentence end found, take full 500
            cut = len(chunk)
        chunk = remaining[:cut]
        return clean_for_tts(chunk)

    def _book_synth_chunk(self, text, idx):
        """Synthesize text to wav with retry. idx for unique temp files."""
        tmp_mp3 = f"/tmp/toth_book_{idx}.mp3"
        tmp_wav = f"/tmp/toth_book_{idx}.wav"
        from edge_tts import Communicate
        import asyncio
        max_retries = 3
        for attempt in range(max_retries):
            try:
                async def synth():
                    com = Communicate(text, "fr-FR-RemyMultilingualNeural", rate="+0%", volume="+0%", pitch="+0Hz")
                    await com.save(tmp_mp3)
                asyncio.run(synth())
                if os.path.exists(tmp_mp3) and os.path.getsize(tmp_mp3) > 100:
                    break
            except Exception as e:
                print(f"[BOOK TTS] Synth attempt {attempt+1} failed: {e}")
                time.sleep(1.0 * (attempt + 1))
        else:
            print(f"[BOOK TTS] All synth retries failed for chunk {idx}")
            return None
        subprocess.run(["ffmpeg", "-y", "-i", tmp_mp3, "-ar", "22050", "-ac", "1", tmp_wav],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
        if os.path.exists(tmp_wav) and os.path.getsize(tmp_wav) > 100:
            try:
                os.remove(tmp_mp3)
            except:
                pass
            return tmp_wav
        return None

    def _book_speak_chunk(self):
        self._stop_all_media(except_tab="LIVRE")
        """Lecture audio fluide: annonce chapitre + pre-synthese chunk suivant.
        Support MP3 pre-synthetises: si chapter a "file" MP3 + "text" vide, joue le MP3 directement."""
        if self._book_is_playing:
            self._book_stop()
            return

        # If chapter_idx == -1, it means "REPRENDRE" — use saved state
        if self._book_chapter_idx == -1:
            # Reload saved state
            try:
                if os.path.exists(self._books_saved):
                    with open(self._books_saved, "r") as f:
                        s = json.load(f)
                    self._book_chapter_idx = s.get("chapter_idx", 0)
                    self._book_char_pos = s.get("char_pos", 0)
                    if self._book_chapter_idx < 0:
                        self._book_chapter_idx = 0
                    # Rewind to start of current paragraph (find \n\n before pos)
                    text = self._book_get_current_text()
                    if text and self._book_char_pos > 0 and self._book_char_pos < len(text):
                        # Search backwards for paragraph break (\n\n) or chapter start
                        search_from = self._book_char_pos
                        # Look for \n\n before current position
                        para_start = text.rfind("\n\n", 0, search_from)
                        if para_start >= 0:
                            self._book_char_pos = para_start + 2  # skip the \n\n
                        else:
                            # No paragraph break found, start from beginning of chapter
                            self._book_char_pos = 0
                        print(f"[BOOK TTS] Reprendre au debut du paragraphe: pos={self._book_char_pos}")
            except Exception:
                self._book_chapter_idx = 0
            self._book_mode = "book"

        # ── MODE MP3 PRE-SYNTHETISE ──
        # Si le chapitre a un fichier MP3 et pas de texte, jouer le MP3 directement
        if self._books and self._book_idx < len(self._books):
            chs = self._books[self._book_idx]["chapters"]
            if self._book_chapter_idx >= 0 and self._book_chapter_idx < len(chs):
                ch = chs[self._book_chapter_idx]
                mp3_file = ch.get("file", "")
                ch_text = ch.get("text", "")
                if mp3_file and not ch_text.strip():
                    # Construire le chemin complet du MP3
                    book_dir = os.path.join(self._books_dir, self._books[self._book_idx].get("_dir_name", ""))
                    if not book_dir or not os.path.isdir(book_dir):
                        # Essayer de trouver le dossier par nom de fichier JSON
                        json_fn = self._books[self._book_idx].get("file", "")
                        base = json_fn.replace(".json", "")
                        book_dir = os.path.join(self._books_dir, base)
                    mp3_path = os.path.join(book_dir, mp3_file) if os.path.isdir(book_dir) else ""
                    
                    if mp3_path and os.path.exists(mp3_path):
                        print(f"[BOOK MP3] Playing: {mp3_path}")
                        self._book_is_playing = True
                        self._book_user_stopped = False
                        self._book_mode = "book"
                        # Sauver l'état avant lecture (chapitre en cours)
                        self._save_book_state()
                        self._show_menu(self._menu_idx)
                        
                        # Annonce vocale du chapitre
                        chapter_title = ch.get("title", f"Partie {self._book_chapter_idx + 1}")
                        try:
                            import asyncio
                            from edge_tts import Communicate
                            ann_mp3 = "/tmp/toth_book_announce.mp3"
                            ann_wav = "/tmp/toth_book_announce.wav"
                            async def synth_ann():
                                com = Communicate(f"Reprise. {chapter_title}.", "fr-FR-RemyMultilingualNeural", rate="+0%", volume="+0%")
                                await com.save(ann_mp3)
                            asyncio.run(synth_ann())
                            subprocess.run(["ffmpeg", "-y", "-i", ann_mp3, "-ar", "22050", "-ac", "1", ann_wav],
                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
                            if os.path.exists(ann_wav) and os.path.getsize(ann_wav) > 100:
                                self._book_proc = subprocess.Popen(["aplay", "-q", "-D", "default", ann_wav],
                                                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                                self._book_proc.wait()
                        except Exception as e:
                            print(f"[BOOK MP3] Announcement failed: {e}")
                        
                        # Jouer le MP3 avec mpg123 (ou ffplay fallback)
                        try:
                            if os.system("which mpg123 >/dev/null 2>&1") == 0:
                                self._book_proc = subprocess.Popen(["mpg123", "-q", "-a", "default", mp3_path],
                                                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                            else:
                                self._book_proc = subprocess.Popen(["ffplay", "-autoexit", "-nodisp", "-loglevel", "quiet", "-i", mp3_path],
                                                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                            self._book_proc.wait()
                        except Exception as e:
                            print(f"[BOOK MP3] Playback failed: {e}")
                        
                        self._book_is_playing = False
                        if not self._book_user_stopped:
                            # Fin naturelle du MP3 → annoncer la transition puis avancer
                            print("[BOOK MP3] Fin naturelle, annonce transition")
                            chapter_title_old = chs[self._book_chapter_idx].get("title", f"Partie {self._book_chapter_idx + 1}")
                            
                            # Annoncer fin du chapitre + début du suivant
                            self._book_next_chapter()
                            new_idx = self._book_chapter_idx
                            if new_idx < len(chs):
                                chapter_title_new = chs[new_idx].get("title", f"Partie {new_idx + 1}")
                                announce_text = f"Fin du chapitre. {chapter_title_old}. Chapitre suivant. {chapter_title_new}."
                            else:
                                announce_text = f"Fin du chapitre. {chapter_title_old}. Fin du livre."
                            
                            try:
                                import asyncio
                                from edge_tts import Communicate
                                ann_mp3 = "/tmp/toth_book_transition.mp3"
                                ann_wav = "/tmp/toth_book_transition.wav"
                                async def synth_trans():
                                    com = Communicate(announce_text, "fr-FR-RemyMultilingualNeural", rate="+0%", volume="+0%")
                                    await com.save(ann_mp3)
                                asyncio.run(synth_trans())
                                subprocess.run(["ffmpeg", "-y", "-i", ann_mp3, "-ar", "22050", "-ac", "1", ann_wav],
                                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
                                if os.path.exists(ann_wav) and os.path.getsize(ann_wav) > 100:
                                    self._book_proc = subprocess.Popen(["aplay", "-q", "-D", "default", ann_wav],
                                                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                                    self._book_proc.wait()
                                    os.remove(ann_wav)
                                if os.path.exists(ann_mp3):
                                    os.remove(ann_mp3)
                            except Exception as e:
                                print(f"[BOOK MP3] Annonce transition échouée: {e}")
                            
                            self._save_book_state()
                            
                            # Enchaîner sur le MP3 suivant automatiquement
                            if new_idx < len(chs):
                                next_ch = chs[new_idx]
                                next_mp3_file = next_ch.get("file", "")
                                next_ch_text = next_ch.get("text", "")
                                if next_mp3_file and not next_ch_text.strip():
                                    next_book_dir = os.path.join(self._books_dir, self._books[self._book_idx].get("_dir_name", ""))
                                    next_mp3_path = os.path.join(next_book_dir, next_mp3_file) if os.path.isdir(next_book_dir) else ""
                                    if next_mp3_path and os.path.exists(next_mp3_path):
                                        print(f"[BOOK MP3] Auto-enchaînement: {next_mp3_path}")
                                        self._book_is_playing = True
                                        self._book_user_stopped = False
                                        self._show_menu(self._menu_idx)
                                        try:
                                            if os.system("which mpg123 >/dev/null 2>&1") == 0:
                                                self._book_proc = subprocess.Popen(["mpg123", "-q", "-a", "default", next_mp3_path],
                                                                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                                            else:
                                                self._book_proc = subprocess.Popen(["ffplay", "-autoexit", "-nodisp", "-loglevel", "quiet", "-i", next_mp3_path],
                                                                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                                            self._book_proc.wait()
                                        except Exception as e:
                                            print(f"[BOOK MP3] Auto-play échoué: {e}")
                                        self._book_is_playing = False
                                        # L'auto-enchaînement continue récursivement
                                        # (le next_chapter + annonce + play se répète)
                                        # Mais pour éviter la récursion infinie, on simule:
                                        self._book_user_stopped = False
                                        self._show_menu(self._menu_idx)
                                        return
                        else:
                            # Arrêt manuel → rester sur le chapitre en cours
                            print("[BOOK MP3] Arrêt manuel, on reste sur ce chapitre")
                        self._book_user_stopped = False
                        self._show_menu(self._menu_idx)
                        return

        # ── MODE TEXTE NORMAL (edge-tts) ──
        # Check we have text
        chunk = self._book_get_smart_chunk()
        if not chunk:
            # Try next chapter
            self._book_next_chapter()
            chunk = self._book_get_smart_chunk()
            if not chunk:
                print("[BOOK TTS] No more text")
                return

        self._book_is_playing = True

        # Get chapter title for announcement
        chapter_title = ""
        try:
            chs = self._books[self._book_idx]["chapters"]
            if self._book_chapter_idx < len(chs):
                chapter_title = chs[self._book_chapter_idx].get("title", "")
        except Exception:
            pass

        try:
            # 1. Announce chapter title + paragraph number (always on reprise)
            if chapter_title:
                # Count which paragraph we're at
                text_full = self._book_get_current_text()
                para_num = text_full[:self._book_char_pos].count("\n\n") + 1
                announce = f"Reprise. {chapter_title}. Paragraphe {para_num}."
                print(f"[BOOK TTS] Annonce: {announce}")
                announce_wav = self._book_synth_chunk(announce, 99)
                if announce_wav and self._book_is_playing:
                    self._book_proc = subprocess.Popen(["aplay", "-q", "-D", "default", announce_wav],
                                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    self._book_proc.wait()
                    try:
                        os.remove(announce_wav)
                    except:
                        pass
                    if not self._book_is_playing:
                        return

            # 2. Pre-synthesize first chunk
            print(f"[BOOK TTS] Chunk 1: {chunk[:60]}...")
            wav1 = self._book_synth_chunk(chunk, 0)
            if not wav1:
                print("[BOOK TTS] Echec synthese chunk 1 — abandon")
                self._book_is_playing = False
                return
            if not self._book_is_playing:
                try:
                    os.remove(wav1)
                except:
                    pass
                return

            chunk_idx = 1
            import threading
            # Pre-synth state: next_wav prepared in background thread
            synth_result = {"wav": None, "chunk": None}
            
            def _bg_synth(text_chunk, idx, result):
                """Synthesize in background thread."""
                try:
                    w = self._book_synth_chunk(text_chunk, idx)
                    result["wav"] = w
                    result["chunk"] = text_chunk
                except Exception as e:
                    print(f"[BOOK TTS] BG synth error: {e}")
                    result["wav"] = None
                    result["chunk"] = text_chunk

            # Pre-synthesize chunk 2 in background while playing chunk 1
            next_chunk = self._book_get_smart_chunk()
            synth_thread = None
            if next_chunk and self._book_is_playing:
                synth_thread = threading.Thread(target=_bg_synth, args=(next_chunk, 1, synth_result))
                synth_thread.start()

            while self._book_is_playing:
                # Play current chunk
                if self._book_is_playing and wav1:
                    self._book_proc = subprocess.Popen(["aplay", "-q", "-D", "default", wav1],
                                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    self._book_proc.wait()

                # Clean up current wav
                try:
                    os.remove(wav1)
                except:
                    pass

                if not self._book_is_playing:
                    break

                # Wait for background synth to finish
                if synth_thread:
                    synth_thread.join(timeout=30)
                next_wav = synth_result["wav"]
                actual_next_chunk = synth_result["chunk"]

                if not next_wav or not actual_next_chunk:
                    # No more text in this chapter? Try next chapter
                    self._book_next_chapter()
                    next_chunk = self._book_get_smart_chunk()
                    if next_chunk:
                        new_title = ""
                        try:
                            chs = self._books[self._book_idx]["chapters"]
                            if self._book_chapter_idx < len(chs):
                                new_title = chs[self._book_chapter_idx].get("title", "")
                        except:
                            pass
                        if new_title:
                            announce = f"Chapitre suivant. {new_title}."
                            ann_wav = self._book_synth_chunk(announce, 98)
                            if ann_wav and self._book_is_playing:
                                self._book_proc = subprocess.Popen(["aplay", "-q", "-D", "default", ann_wav],
                                                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                                self._book_proc.wait()
                                try:
                                    os.remove(ann_wav)
                                except:
                                    pass
                        next_wav = self._book_synth_chunk(next_chunk, chunk_idx % 2)
                        actual_next_chunk = next_chunk
                    else:
                        print("[BOOK TTS] Fin du livre")
                        break

                # Advance position
                text = self._book_get_current_text()
                chunk_end = min(self._book_char_pos + len(chunk), len(text))
                self._book_char_pos = chunk_end
                self._save_book_state()

                wav1 = next_wav
                chunk = actual_next_chunk
                chunk_idx += 1

                # Start background synth for NEXT chunk
                synth_result = {"wav": None, "chunk": None}
                next_chunk = self._book_get_smart_chunk()
                if next_chunk and self._book_is_playing:
                    synth_thread = threading.Thread(target=_bg_synth, args=(next_chunk, chunk_idx % 2, synth_result))
                    synth_thread.start()
                else:
                    synth_thread = None

        except Exception as e:
            print(f"[BOOK TTS] error: {e}")
        finally:
            self._book_is_playing = False
            self._book_proc = None
            # Clean up temp files
            for i in range(3):
                try:
                    os.remove(f"/tmp/toth_book_{i}.mp3")
                    os.remove(f"/tmp/toth_book_{i}.wav")
                except:
                    pass
            try:
                os.remove("/tmp/toth_book_99.mp3")
                os.remove("/tmp/toth_book_99.wav")
                os.remove("/tmp/toth_book_98.mp3")
                os.remove("/tmp/toth_book_98.wav")
            except:
                pass

    def _book_stop(self):
        self._book_user_stopped = True
        try:
            self._save_book_state()
        except:
            pass
        try:
            if self._book_proc and self._book_proc.poll() is None:
                self._book_proc.terminate()
                try:
                    self._book_proc.wait(timeout=0.5)
                except Exception:
                    self._book_proc.kill()
        except Exception:
            pass
        self._book_is_playing = False
        self._book_proc = None

