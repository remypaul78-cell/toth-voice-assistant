    def _watch_override_file(self):
        """Watch /tmp/toth_display_override.txt — when modified, display its content for 8 seconds."""
        import time
        while True:
            try:
                if os.path.exists(self._override_file):
                    mtime = os.path.getmtime(self._override_file)
                    if mtime > self._override_mtime:
                        self._override_mtime = mtime
                        with open(self._override_file, "r") as f:
                            msg = f.read().strip()
                        if msg:
                            print(f"[OVERRIDE] Displaying: {msg[:60]}")
                            self._disp(msg, fs=22)
            except Exception as e:
                print(f"[OVERRIDE] Error: {e}")
            time.sleep(0.5)

    def _disp_scroll(self, full_text, batch_idx, total_batches, duration=None):
        """Smooth scroll: white bg, black text, font 22. Scrolls text upward during TTS playback."""
        import re
        if duration is None:
            duration = 5.0  # default if no MP3 duration available
        print(f"[DISP-SCROLL] batch={batch_idx}/{total_batches}, duration={duration:.1f}s, text_len={len(full_text)}")
        try:
            from PIL import Image, ImageDraw, ImageFont
            FONT_SIZE = 22
            font = ImageFont.truetype(FONT_PATH, FONT_SIZE)
            line_h = FONT_SIZE + 4
            screen_h = 280

            # Split into sentences (same logic as speak())
            sentences = re.split(r'(?<=[.!?»])\s+', full_text)
            merged = []
            for s in sentences:
                s = s.strip()
                if not s:
                    continue
                if merged and len(merged[-1]) < 8 and merged[-1][-1] not in '.!?»':
                    merged[-1] = merged[-1] + " " + s
                else:
                    merged.append(s)
            sentences = merged

            # Get current batch sentences (BATCH_SIZE=3, same as speak())
            BATCH_SIZE = 3
            start_s = batch_idx * BATCH_SIZE
            end_s = min(start_s + BATCH_SIZE, len(sentences))
            batch_sentences = sentences[start_s:end_s]
            batch_text = " ".join(batch_sentences)

            # Word-wrap
            words = batch_text.split()
            lines = []
            cur = ""
            for w in words:
                t = (cur + " " + w).strip() if cur else w
                b = font.getbbox(t)
                if (b[2] - b[0]) > 224:
                    if cur:
                        lines.append(cur)
                    cur = w
                else:
                    cur = t
            if cur:
                lines.append(cur)

            total_text_h = len(lines) * line_h + 16  # top+bottom padding

            # If text fits on screen, just show it static — no scroll needed
            if total_text_h <= screen_h:
                img = Image.new("RGB", (240, screen_h), "#000000")
                draw = ImageDraw.Draw(img)
                y = (screen_h - total_text_h) // 2 + 8
                for line in lines:
                    draw.text((8, y), line, font=font, fill="#FFFF00")
                    y += line_h
                with self._display_lock:
                    self.board.draw_image(0, 0, 240, screen_h, pil_to_rgb565(img))
                return

            # Scroll animation — smooth upward at ~50 px/sec
            scroll_speed = 100.0  # px/sec (2x accéléré)
            total_scroll = total_text_h - screen_h + 20
            anim_duration = min(duration, total_scroll / scroll_speed)
            fps = 12
            step = total_scroll / max(1, anim_duration * fps)
            frame_time = 1.0 / fps

            print(f"[SCROLL] lines={len(lines)}, total_h={total_text_h}, scroll={total_scroll:.0f}px, "
                  f"anim={anim_duration:.1f}s, fps={fps}, step={step:.1f}px")

            # Stop any previous scroll
            self._scroll_running = False
            time.sleep(0.05)

            self._scroll_running = True
            def animate():
                scroll_y = 0.0
                last_frame = None
                while self._scroll_running and scroll_y < total_scroll:
                    try:
                        img = Image.new("RGB", (240, screen_h), "#000000")
                        draw = ImageDraw.Draw(img)
                        y = 8 - scroll_y
                        for line in lines:
                            if -line_h < y < screen_h:
                                draw.text((8, y), line, font=font, fill="#FFFF00")
                            y += line_h

                        # Only push frame if different (SPI is slow on Pi Zero)
                        data = pil_to_rgb565(img)
                        if data != last_frame:
                            with self._display_lock:
                                self.board.draw_image(0, 0, 240, screen_h, data)
                            last_frame = data

                        scroll_y += step
                        time.sleep(frame_time)
                    except Exception as e:
                        print(f"[SCROLL] Frame error: {e}")
                        break
                # Final frame: show last lines
                try:
                    img = Image.new("RGB", (240, screen_h), "#000000")
                    draw = ImageDraw.Draw(img)
                    y = screen_h - (len(lines) * line_h) - 8
                    for line in lines:
                        draw.text((8, y), line, font=font, fill="#FFFF00")
                        y += line_h
                    with self._display_lock:
                        self.board.draw_image(0, 0, 240, screen_h, pil_to_rgb565(img))
                except Exception:
                    pass

            t = threading.Thread(target=animate, daemon=True)
            t.start()

        except Exception as e:
            print(f"[DISP-SCROLL] Error: {e} — fallback")
            try:
                self._disp(full_text[:200], 22)
            except Exception:
                pass

    def _stop_scroll(self):
        """Stop the smooth scroll animation thread."""
        self._scroll_running = False


    def _start_screensaver(self):
        """Demarre le screensaver: photos en ordre aleatoire, duree aleatoire (5-15s)."""
        if self._screensaver_active or not self._screensaver_files:
            return
        self._screensaver_active = True
        def loop():
            import random
            while self._screensaver_active and self._clock_running:
                fpath = random.choice(self._screensaver_files)
                try:
                    from PIL import Image as _IMG
                    img = _IMG.open(fpath).convert("RGB").resize((240, 280), _IMG.LANCZOS)
                    data = pil_to_rgb565(img)
                    with self._display_lock:
                        self.board.draw_image(0, 0, 240, 280, data)
                    print(f"[SCREENSAVER] Affiche {os.path.basename(fpath)}")
                except Exception as e:
                    print(f"[SCREENSAVER] Erreur: {e}")
                wait = random.uniform(5, 15)
                t0 = time.time()
                while self._screensaver_active and self._clock_running and (time.time() - t0) < wait:
                    time.sleep(0.5)
        self._screensaver_thread = threading.Thread(target=loop, daemon=True)
        self._screensaver_thread.start()

    def _stop_screensaver(self):
        """Arrete le screensaver."""
        self._screensaver_active = False

    def _start_clock(self):
        """Affiche la video d'idle en boucle - visage robot desactive."""
        if self._clock_running:
            return
        self._clock_running = True
        self._rgb(0, 0, 0)
        IDLE_VIDEO_FILE = "/home/pi/toth/idle_video_frames.raw"
        IDLE_VIDEO_FRAME_SIZE = 240 * 280 * 2  # RGB565
        IDLE_VIDEO_FPS = 2.5
        IDLE_VIDEO_FRAME_TIME = 1.0 / IDLE_VIDEO_FPS
        def loop():
            try:
                if not os.path.exists(IDLE_VIDEO_FILE):
                    print(f"[IDLE] Video file not found: {IDLE_VIDEO_FILE}, falling back to image")
                    if os.path.exists(IDLE_IMAGE):
                        with open(IDLE_IMAGE, "rb") as f:
                            raw = f.read()
                        raw = overlay_battery_on_raw(raw)
                        with self._display_lock:
                            self.board.draw_image(0, 0, 240, 280, raw)
                    else:
                        self._clear()
                    while self._clock_running:
                        time.sleep(1)
                    return
                # Get file size to know frame count
                file_size = os.path.getsize(IDLE_VIDEO_FILE)
                num_frames = file_size // IDLE_VIDEO_FRAME_SIZE
                print(f"[IDLE] Video idle: {num_frames} frames, {file_size} bytes")
                while self._clock_running:
                    with open(IDLE_VIDEO_FILE, "rb") as vf:
                        frame_idx = 0
                        while self._clock_running and frame_idx < num_frames:
                            raw = vf.read(IDLE_VIDEO_FRAME_SIZE)
                            if len(raw) < IDLE_VIDEO_FRAME_SIZE:
                                break
                            # Overlay battery every 60 frames (~3s)
                            if frame_idx % 60 == 0:
                                raw = overlay_battery_on_raw(raw)
                            with self._display_lock:
                                self.board.draw_image(0, 0, 240, 280, raw)
                            frame_idx += 1
                            time.sleep(IDLE_VIDEO_FRAME_TIME)
            except Exception as e:
                print(f"[IDLE] Erreur video idle: {e}")
                import traceback; traceback.print_exc()
        self._clock_thread = threading.Thread(target=loop, daemon=True)
        self._clock_thread.start()
        self._batt_timer = threading.Timer(900, self._send_battery_telegram)
        self._batt_timer.daemon = True
        self._batt_timer.start()

