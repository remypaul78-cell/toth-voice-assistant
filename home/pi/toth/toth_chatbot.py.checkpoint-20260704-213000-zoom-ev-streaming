    # ── Radio via mpg123 ──────────────────────────────────────────────
    def _ring_radio_stations(self):
        """Return ordered list of station URLs (same stations as radio.py)."""
        import radio as radio_mod
        return list(radio_mod.RADIOS.values())  # [(name, url), ...]

    def _ring_radio_play(self):
        """Start radio on the current station. Routes to BT sink if connected, else WM8960."""
        self._stop_all_media(except_tab="RADIO")
        with self._radio_fade_lock:
            stations = self._ring_radio_stations()
            if not stations:
                return
            idx = self._radio_station_idx % len(stations)
            name, url = stations[idx]
            print(f"[RADIO] ▶ {name}")
            try:
                if self._radio_proc:
                    self._radio_proc.kill()
                    self._radio_proc = None

                # --- Dynamic audio routing ---
                # Check if a Bluetooth sink is connected and available
                bt_sink = None
                try:
                    sinks_out = subprocess.run(
                        ["pactl", "list", "sinks", "short"],
                        capture_output=True, text=True, timeout=3
                    ).stdout
                    for line in sinks_out.strip().split("\n"):
                        if "bluez" in line:
                            parts = line.split("\t")
                            if len(parts) >= 2:
                                bt_sink = parts[1]
                                break
                except Exception:
                    pass

                if bt_sink:
                    # Route to Bluetooth (Bose or any connected BT speaker)
                    try:
                        subprocess.run(["pactl", "set-default-sink", bt_sink], timeout=3)
                        print(f"[RADIO] Routing to BT sink: {bt_sink}")
                    except Exception:
                        pass
                    self._radio_proc = subprocess.Popen(
                        ["ffmpeg", "-i", url, "-ar", "48000", "-ac", "2", "-f", "pulse", "-nostdin", "-loglevel", "error"],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    )
                else:
                    # No BT connected → fallback to WM8960 (enseigne) via ALSA direct
                    print("[RADIO] No BT sink found → routing to WM8960 (plughw:0,0)")
                    self._radio_proc = subprocess.Popen(
                        ["ffmpeg", "-i", url, "-ar", "48000", "-ac", "2", "-f", "alsa", "plughw:0,0", "-nostdin", "-loglevel", "error"],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    )

                self._radio_playing = True
                self._radio_playing_idx = idx
            except Exception as e:
                print(f"[RADIO] Play error: {e}")

    def _stop_all_media(self, except_tab=None):
        """Arrête toutes les sources média sauf celle spécifiée. Comme une télé : quand on change de source, l'ancienne se coupe."""
        if except_tab != "RADIO" and getattr(self, '_radio_playing', False):
            print("[MEDIA] Stop radio (source switch)")
            self._ring_radio_stop()
        if except_tab != "LIVRE" and getattr(self, '_book_is_playing', False):
            print("[MEDIA] Stop livre (source switch)")
            self._book_stop()
        if except_tab != "YT" and getattr(self, '_yt_is_playing', False):
            print("[MEDIA] Stop YT (source switch)")
            self._yt_stop(silent=True)
        if except_tab != "ZIK":
            try:
                import urllib.request
                req = urllib.request.Request("http://49.13.237.85:9876/control",
                    data=b'{"endpoint":"pause"}',
                    headers={"Authorization": "Bearer hermes-vps-key-mesh-2026", "Content-Type": "application/json"},
                    method="POST")
                urllib.request.urlopen(req, timeout=3)
                print("[MEDIA] Pause Spotify (source switch)")
            except: pass

    def _ring_radio_stop(self):
        """Stop radio playback."""
        with self._radio_fade_lock:
            if self._radio_proc:
                self._radio_proc.kill()
                self._radio_proc = None
            self._radio_playing = False
            self._radio_playing_idx = -1

    def _ring_radio_toggle(self):
        """Toggle radio on/off."""
        if self._radio_playing:
            self._ring_radio_stop()
        else:
            self._ring_radio_play()

    def _ring_radio_next(self):
        """Switch to next station."""
        self._radio_station_idx = (self._radio_station_idx + 1) % len(self._ring_radio_stations())
        if self._radio_playing:
            self._ring_radio_play()
        else:
            name, _ = self._ring_radio_stations()[self._radio_station_idx]
            print(f"[RADIO] Selected: {name} (radio off)")

    def _ring_radio_prev(self):
        """Switch to previous station."""
        total = len(self._ring_radio_stations())
        self._radio_station_idx = (self._radio_station_idx - 1) % total
        if self._radio_playing:
            self._ring_radio_play()
        else:
            name, _ = self._ring_radio_stations()[self._radio_station_idx]
            print(f"[RADIO] Selected: {name} (radio off)")

    def _ring_radio_volume(self, direction):
        """Adjust radio volume via amixer Speaker. direction='up' or 'down'."""
        step = 5   # 5 = ~4% of 127
        new = self._radio_volume + step if direction == "up" else self._radio_volume - step
        new = max(0, min(127, new))
        if new != self._radio_volume:
            self._radio_volume = new
            try:
                subprocess.run(
                    ["amixer", "-c", "0", "set", "Master", str(new)],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
                pct = (new * 100) // 127
                print(f"[RADIO] 🔈 Volume {pct}%")
            except Exception as e:
                print(f"[RADIO] Volume error: {e}")

    def run(self):
        print("[TOTH] Started (Hermes direct mode).")
        # Règle 2 (auto-réparation) : heartbeat toutes les 5s
        heartbeat_path = "/tmp/toth_heartbeat"
        try:
            while True:
                try:
                    with open(heartbeat_path, "w") as f:
                        f.write(str(time.time()))
                except Exception:
                    pass
                time.sleep(POLL_INT)
        except KeyboardInterrupt:
            print("[TOTH] Shutdown.")
        finally:
            try: os.remove(heartbeat_path)
            except Exception: pass
            self._down()

    def _down(self):
        self._rgb(0, 0, 0)
        if self.rec:
            try: self.rec.stop()
            except Exception: pass
        if self.board:
            try: self.board.cleanup()
            except Exception: pass

