    def _start_spotify_poll(self):
        if getattr(self, '_spotify_poll_timer', None):
            try: self._spotify_poll_timer.cancel()
            except Exception: pass
        def _poll():
            try:
                import json as _json, urllib.request
                url = "http://49.13.237.85:9876/now_playing"
                headers = {
                    "Authorization": "Bearer hermes-vps-key-mesh-2026",
                    "Content-Type": "application/json"
                }
                req = urllib.request.Request(url, headers=headers, method="POST", data=b"{}")
                with urllib.request.urlopen(req, timeout=15) as resp:
                    data = _json.loads(resp.read().decode())
                raw_name = data.get("name", "?")
                raw_artist = data.get("artist", "")
                raw_playing = bool(data.get("is_playing", False))
                pending = getattr(self, '_media_music_now_playing', {}).get("pending", False)
                launch_age = time.time() - getattr(self, '_media_music_launch_at', 0)
                known = raw_name not in ("?", "", None) and raw_artist not in ("?",)
                if pending and not known and launch_age < 8:
                    # Spotify may still be starting; keep displayed metadata
                    print(f"[SPOTIFY POLL] pending, ignoring empty response ({raw_name}, age={launch_age:.1f}s)")
                else:
                    old = self._media_music_now_playing or {}
                    self._media_music_now_playing = {
                        "name": raw_name if known else old.get("name", raw_name),
                        "artist": raw_artist if known else old.get("artist", raw_artist),
                        "is_playing": raw_playing,
                        "pending": False
                    }
                # Refresh display if we are on now-playing screen
                if self._media_music_sel == 3 and self._menu_items[self._menu_idx] == "MEDIA":
                    cur_tab = self._media_tabs[self._media_idx % len(self._media_tabs)]
                    if cur_tab == "ZIK" and getattr(self, '_media_inside', False):
                        self._show_menu(self._menu_idx)
            except Exception as e:
                print(f"[SPOTIFY POLL] {e}")
            # Reschedule
            self._spotify_poll_timer = threading.Timer(5.0, _poll)
            self._spotify_poll_timer.daemon = True
            self._spotify_poll_timer.start()
        self._spotify_poll_timer = threading.Timer(1.0, _poll)
        self._spotify_poll_timer.daemon = True
        self._spotify_poll_timer.start()

