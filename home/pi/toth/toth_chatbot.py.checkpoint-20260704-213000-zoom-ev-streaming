        q = query.strip().lower()
        # Supprimer les mots parasites / contexte de contrôle
        q = re.sub(r"\b(toth|tote|toph|thor|tôt|tôtôt|ermes|hermès|hermes|rémy|remy|rémi|remi|dis?|dit|s'il te pla[îtit]|stp|merci|s'il vous pla[îtit]|voilà|hop|euh|hum|alors|ben)\b", "", q)
        # Supprimer les incitations à jouer la musique
        q = re.sub(r"\b(mets?|joue?|lance|cherche|trouve|veux|voudrais|écoute|ecoute|m'|me)\\s+(du|de la|de l'|un|une|la|le|les|des|ce|cette|ces|ca|ça|sa|son|ses|leur|leurs)?\\b", "", q)
        # Normaliser les ponctuations multiples
        q = re.sub(r"[.,;:!?\\-]+", " ", q)
        # Nettoyer les espaces
        q = re.sub(r"\\s+", " ", q).strip()
        # Capitaliser la première lettre
        if q:
            q = q[0].upper() + q[1:]
        return q if q else query.strip()


